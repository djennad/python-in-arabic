"""ستريمليت بالعربية: واجهة عربية لمكتبة Streamlit لبناء مواقع وتطبيقات البيانات.

    استورد ستريمليت باسم ست

    ست.عنوان("مرحبا")
    الاسم = ست.حقل_نص("ما اسمك؟")
    إذا ست.زر("حيّني"):
        ست.نجاح(f"أهلا يا {الاسم}")

- كل دوال Streamlit لها أسماء عربية، ومعاملاتها بالعربية أيضا:
  ست.منزلق("العمر"، الأدنى=٠، الأقصى=١٠٠، القيمة=٣٠)
- الحاويات عربية كذلك: مع ست.الشريط_الجانبي: ... ، أ، ب = ست.أعمدة(٢)
- الأسماء الإنجليزية الأصلية متاحة دائما عبر ست.الأصل (أي مكتبة streamlit نفسها).

التشغيل: في ساحة أفعى مباشرة، أو على الجهاز بالأمر  afaa --streamlit تطبيقي.af
التوثيق الكامل في docs/streamlit.md.
"""

استورد streamlit باسم _st
من streamlit.delta_generator استورد DeltaGenerator باسم _مولد
من afaa.vocabulary استورد ARABIC_TO_PYTHON باسم _القاموس، normalize باسم _طبع

# المكتبة الأصلية لمن يريد أسماءها الإنجليزية
الأصل = _st


دالة _بايثون(الاسم):
    """الاسم كما يصل من شيفرة المستخدم بعد الترجمة (مثل «عنوان» ← title)."""
    أرجع _القاموس.احصل(_طبع(الاسم)، الاسم)


# ---------------------------------------------------------------------------
# الدوال: الاسم العربي ← اسم Streamlit
# ---------------------------------------------------------------------------
_الدوال = {
    # النصوص
    "عنوان": "title"، "ترويسة": "header"، "ترويسة_فرعية": "subheader"،
    "نص_منسق": "markdown"، "نص_عادي": "text"، "اكتب": "write"، "شيفرة": "code"،
    "معادلة": "latex"، "تعليق": "caption"، "خط_فاصل": "divider"، "صفحة_html": "html"،
    # البيانات
    "جدول_بيانات": "dataframe"، "محرر_بيانات": "data_editor"، "جدول": "table"،
    "مقياس": "metric"، "جيسون": "json"،
    # الرسوم البيانية
    "رسم_خطي": "line_chart"، "رسم_أعمدة": "bar_chart"، "رسم_مساحي": "area_chart"،
    "رسم_نقاط": "scatter_chart"، "خريطة": "map"، "رسم_ماتبلوتليب": "pyplot"،
    "رسم_ألتير": "altair_chart"،
    # الإدخال
    "زر": "button"، "زر_تنزيل": "download_button"، "زر_رابط": "link_button"،
    "رابط_صفحة": "page_link"، "مربع_اختيار": "checkbox"، "مفتاح_تبديل": "toggle"،
    "اختيار_واحد": "radio"، "قائمة_منسدلة": "selectbox"، "اختيار_متعدد": "multiselect"،
    "منزلق": "slider"، "منزلق_خيارات": "select_slider"، "حقل_نص": "text_input"،
    "حقل_عدد": "number_input"، "منطقة_نص": "text_area"، "حقل_تاريخ": "date_input"،
    "حقل_وقت": "time_input"، "رفع_ملف": "file_uploader"، "منتقي_لون": "color_picker"،
    "كاميرا": "camera_input"، "حقل_دردشة": "chat_input"، "رسالة_دردشة": "chat_message"،
    "تقييم": "feedback"، "أزرار_اختيار": "pills"، "أزرار_مقطعة": "segmented_control"،
    # الوسائط
    "صورة": "image"، "صوت": "audio"، "فيديو": "video"،
    # التخطيط
    "أعمدة": "columns"، "ألسنة": "tabs"، "قابل_للطي": "expander"، "حاوية": "container"،
    "مكان_فارغ": "empty"، "استمارة": "form"، "زر_إرسال": "form_submit_button"،
    "منبثقة": "popover"، "نافذة_حوار": "dialog"،
    # الحالة والرسائل
    "نجاح": "success"، "معلومة": "info"، "تحذير": "warning"، "رسالة_خطأ": "error"،
    "اعرض_استثناء": "exception"، "شريط_تقدم": "progress"، "انتظار": "spinner"،
    "حالة_تقدم": "status"، "بالونات": "balloons"، "ثلج": "snow"، "تنبيه": "toast"،
    # التحكم
    "أعد_التشغيل": "rerun"، "أوقف": "stop"، "اضبط_الصفحة": "set_page_config"،
    "خزن_البيانات": "cache_data"، "خزن_المورد": "cache_resource"، "جزء_مستقل": "fragment"،
}

# ---------------------------------------------------------------------------
# المعاملات المسماة: الاسم العربي ← اسم Streamlit
# (مساعدة ومفتاح ونوع وافتراضي تُترجم أصلا في أفعى إلى help وkey وtype وdefault)
# ---------------------------------------------------------------------------
_المعاملات = {
    "التسمية": "label"، "القيمة": "value"، "الأدنى": "min_value"، "الأقصى": "max_value"،
    "الخطوة": "step"، "الخيارات": "options"، "الافتراضي": "default"،
    "عند_التغيير": "on_change"، "عند_الضغط": "on_click"، "عند_الإرسال": "on_submit"،
    "معطل": "disabled"، "تلميح": "placeholder"، "الارتفاع": "height"، "العرض": "width"،
    "الفهرس": "index"، "الصيغة": "format"، "دالة_العرض": "format_func"، "الأيقونة": "icon"،
    "التخطيط": "layout"، "عنوان_الصفحة": "page_title"، "أيقونة_الصفحة": "page_icon"،
    "حالة_الشريط": "initial_sidebar_state"، "إظهار_التسمية": "label_visibility"،
    "أفقي": "horizontal"، "موسع": "expanded"، "بحدود": "border"، "المسافة": "gap"،
    "الحد_الأقصى_للأحرف": "max_chars"، "الحد_الأقصى_للاختيارات": "max_selections"،
    "متعدد": "accept_multiple_files"، "اللغة": "language"، "أرقام_الأسطر": "line_numbers"،
    "الفرق": "delta"، "لون_الفرق": "delta_color"، "الوصف": "caption"، "البيانات": "data"،
    "اسم_الملف": "file_name"، "نوع_الملف": "mime"، "س": "x"، "ص": "y"، "اللون": "color"،
    "امسح_عند_الإرسال": "clear_on_submit"، "الاسم": "name"، "الصورة_الرمزية": "avatar"،
    "مدة_الصلاحية": "ttl"، "إخفاء_الفهرس": "hide_index"، "ملء_العرض": "use_container_width"،
    "المحاذاة_العمودية": "vertical_alignment"، "النص": "text"، "الرابط": "url"،
    "تسمية_س": "x_label"، "تسمية_ص": "y_label"، "وضع_الاختيار": "selection_mode"،
    "خط_تحت": "divider"، "العنوان": "title"، "عرض_الوقت": "show_time"،
}
_المعاملات = {_بايثون(ع): إ لكل ع، إ في _المعاملات.العناصر()}

# قيم عربية لبعض المعاملات
_القيم = {
    "type": {"أساسي": "primary"، "ثانوي": "secondary"، "ثالثي": "tertiary"}،
    "layout": {"واسع": "wide"، "وسط": "centered"}،
    "initial_sidebar_state": {"مفتوح": "expanded"، "مغلق": "collapsed"، "تلقائي": "auto"}،
    "label_visibility": {"ظاهر": "visible"، "مخفي": "hidden"، "مطوي": "collapsed"}،
    "gap": {"صغير": "small"، "متوسط": "medium"، "كبير": "large"}،
    "delta_color": {"عادي": "normal"، "معكوس": "inverse"، "رمادي": "off"}،
    "vertical_alignment": {"أعلى": "top"، "وسط": "center"، "أسفل": "bottom"}،
    "width": {"ملء": "stretch"، "المحتوى": "content"}،
    "name": {"مستخدم": "user"، "مساعد": "assistant"}،
    "selection_mode": {"واحد": "single"، "متعدد": "multi"}،
    "divider": {"أزرق": "blue"، "أخضر": "green"، "برتقالي": "orange"، "أحمر": "red"،
                "بنفسجي": "violet"، "رمادي": "gray"، "قوس_قزح": "rainbow"}،
}
_القيم = {مفتاح_: {_طبع(ع): إ لكل ع، إ في قيم.العناصر()} لكل مفتاح_، قيم في _القيم.العناصر()}


دالة _قيمة(المعامل، القيمة):
    إذا من_نوع(القيمة، نص) و المعامل في _القيم:
        أرجع _القيم[المعامل].احصل(_طبع(القيمة)، القيمة)
    أرجع القيمة


دالة _معاملات(المعاملات_):
    نتيجة = {}
    لكل الاسم، القيمة في المعاملات_.العناصر():
        إنجليزي = _المعاملات.احصل(الاسم، الاسم)
        نتيجة[إنجليزي] = _قيمة(إنجليزي، القيمة)
    أرجع نتيجة


دالة _غلف(النتيجة):
    """الحاويات التي تعيدها Streamlit تُغلَّف لتفهم الأسماء العربية أيضا."""
    إذا من_نوع(النتيجة، _مولد):
        أرجع _حاوية_عربية(النتيجة)
    إذا من_نوع(النتيجة، (قائمة، صف)) و النتيجة و الكل(من_نوع(ع، _مولد) لكل ع في النتيجة):
        أرجع [_حاوية_عربية(ع) لكل ع في النتيجة]
    أرجع النتيجة


صنف _حاوية_عربية:
    """غلاف عربي لحاوية Streamlit (الصفحة، الشريط الجانبي، عمود، لسان...)."""

    دالة __تهيئة__(ذات، الأصل):
        ذات._الأصل = الأصل

    دالة __دخول__(ذات):
        ذات._الأصل.__enter__()
        أرجع ذات

    دالة __خروج__(ذات، *معطيات):
        أرجع ذات._الأصل.__exit__(*معطيات)

    دالة __جلب_خاصية__(ذات، الاسم):
        # أي اسم إنجليزي غير معرّف هنا يُمرَّر إلى الحاوية الأصلية
        أرجع _غلف(اجلب_خاصية(ذات._الأصل، الاسم))

    دالة __تمثيل__(ذات):
        أرجع f"<حاوية ستريمليت {ذات._الأصل!r}>"


دالة _اصنع_دالة(الاسم_العربي، الاسم_الإنجليزي):
    دالة دالة_(ذات، *المعطيات_، **المعاملات_):
        إذا الاسم_الإنجليزي == "chat_message" و المعطيات_:
            المعطيات_ = (_قيمة("name"، المعطيات_[٠])،) + صف(المعطيات_[١:])
        الهدف = اجلب_خاصية(ذات._الأصل، الاسم_الإنجليزي)
        أرجع _غلف(الهدف(*المعطيات_، **_معاملات(المعاملات_)))
    دالة_.__اسم__ = الاسم_العربي
    دالة_.__توثيق__ = f"ستريمليت: {الاسم_الإنجليزي} (st.{الاسم_الإنجليزي})"
    أرجع دالة_


لكل _عربي، _إنجليزي في _الدوال.العناصر():
    عين_خاصية(_حاوية_عربية، _بايثون(_عربي)، _اصنع_دالة(_عربي، _إنجليزي))

# ---------------------------------------------------------------------------
# دوال الوحدة: ست.عنوان(...) وأخواتها تعمل على الصفحة الرئيسية
# ---------------------------------------------------------------------------
_الصفحة = _حاوية_عربية(_st)
لكل _عربي في _الدوال:
    العموميات()[_بايثون(_عربي)] = اجلب_خاصية(_الصفحة، _بايثون(_عربي))

الشريط_الجانبي = _حاوية_عربية(_st.sidebar)


دالة __جلب_خاصية__(الاسم):
    # خصائص تتغير في كل تشغيل، فتُقرأ عند الطلب
    إذا الاسم == "حالة_الجلسة":
        أرجع _st.session_state
    إذا الاسم == "معاملات_الرابط":
        أرجع _st.query_params
    ارفع خطأ_خاصية(f"لا يوجد في ستريمليت اسم «{الاسم}». الأسماء الإنجليزية متاحة عبر ست.الأصل")
