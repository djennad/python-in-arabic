"""قواعد_البيانات: قواعد بيانات SQLite بالعربية، باستعلامات SQL عربية.

مثال:

    من قواعد_البيانات استورد قاعدة_بيانات

    ق = قاعدة_بيانات("مدرستي")
    ق.نفذ("أنشئ جدول إذا لم يوجد الطلاب (الاسم نص، العمر عدد_صحيح)")
    ق.نفذ("أدخل إلى الطلاب القيم (؟، ؟)"، "أحمد"، ١٦)
    لكل طالب في ق.استعلم("اختر * من الطلاب رتب حسب العمر"):
        اطبع(طالب["الاسم"]، طالب["العمر"])

على الجهاز تُحفظ القاعدة في ملف (مدرستي.db)، وفي المتصفح تُحفظ في ذاكرته
الدائمة فتبقى بعد إغلاق الصفحة. الاستعلامات تُكتب بالعربية أو بالإنجليزية.
التوثيق الكامل في docs/database.md.
"""

استورد os باسم _os
استورد sqlite3 باسم _sqlite
من afaa استورد storage باسم _تخزين
من afaa.sql استورد translate_sql باسم _ترجم، arabize_error باسم _عرب


صنف خطأ_قاعدة_بيانات(استثناء):
    """خطأ في قاعدة البيانات أو في صياغة الاستعلام."""


# يُعرض في رسائل الأخطاء باسمه فقط، مثل الأخطاء المدمجة (دون «قواعد_البيانات.»)
خطأ_قاعدة_بيانات.__وحدة__ = "builtins"


صنف صف_بيانات(قاموس):
    """صف من نتيجة استعلام. يُقرأ بالاسم: صف_["الاسم"] أو صف_.الاسم"""

    دالة __جلب_خاصية__(ذات، الاسم):
        حاول:
            أرجع ذات[الاسم]
        باستثناء خطأ_مفتاح:
            ارفع خطأ_خاصية(f"لا يوجد عمود باسم «{الاسم}»") من لاشيء


دالة ترجم_استعلام(الاستعلام):
    """يعيد الاستعلام بلغة SQL الإنجليزية، للتعلم أو للتحقق."""
    أرجع _ترجم(الاستعلام)


دالة _معطيات(قيم):
    """يقبل: نفذ(س، أ، ب) أو نفذ(س، [أ، ب]) أو نفذ(س، {"الاسم": أ})"""
    إذا طول(قيم) == ١ و من_نوع(قيم[٠]، (قائمة، صف، قاموس)):
        أرجع قيم[٠]
    أرجع قيم


صنف _معاملة:
    """كل الأوامر داخلها تُعتمد معا، أو تُلغى كلها إن حدث خطأ."""

    دالة __تهيئة__(ذات، القاعدة):
        ذات.القاعدة = القاعدة

    دالة __دخول__(ذات):
        ذات.القاعدة._نفذ_مباشرة("BEGIN")
        أرجع ذات.القاعدة

    دالة __خروج__(ذات، نوع_الخطأ، الخطأ، التتبع):
        إذا نوع_الخطأ هو لاشيء:
            ذات.القاعدة._نفذ_مباشرة("COMMIT")
            _تخزين.persist()
        وإلا:
            ذات.القاعدة._نفذ_مباشرة("ROLLBACK")
        أرجع خطأ


صنف قاعدة_بيانات:
    """قاعدة بيانات SQLite.

    قاعدة_بيانات("مدرستي")  ← ملف مدرستي.db (أو ذاكرة المتصفح الدائمة)
    قاعدة_بيانات()          ← قاعدة مؤقتة في الذاكرة تختفي عند الإغلاق
    """

    دالة __تهيئة__(ذات، الاسم=":ذاكرة:"):
        ذات.الاسم = الاسم
        ذات.المسار = _تخزين.resolve(الاسم)
        إذا ذات.المسار != ":memory:":
            المجلد = _os.path.dirname(_os.path.abspath(ذات.المسار))
            _os.makedirs(المجلد، exist_ok=صح)
        حاول:
            ذات._اتصال = _sqlite.connect(ذات.المسار، isolation_level=لاشيء)
        باستثناء _sqlite.Error باسم خ:
            ارفع خطأ_قاعدة_بيانات(_عرب(نص(خ))) من لاشيء
        ذات._اتصال.row_factory = _sqlite.Row
        ذات._اتصال.execute("PRAGMA foreign_keys = ON")
        ذات.آخر_معرف = لاشيء

    # -- التنفيذ -------------------------------------------------------------
    دالة _نفذ_مباشرة(ذات، sql، المعطيات=()، الأصل=لاشيء، متعدد=خطأ، اعرض_الاستعلام=صح):
        حاول:
            إذا متعدد:
                أرجع ذات._اتصال.executemany(sql، المعطيات)
            أرجع ذات._اتصال.execute(sql، المعطيات)
        باستثناء (_sqlite.Error، خطأ_قيمة، خطأ_نوع، OverflowError) باسم خ:
            # استعلامات النماذج مولَّدة بالإنجليزية، فلا نعرضها للمستخدم
            الاستعلام = (الأصل أو sql) إذا اعرض_الاستعلام وإلا لاشيء
            ارفع خطأ_قاعدة_بيانات(_عرب(نص(خ)، الاستعلام)) من لاشيء

    دالة نفذ(ذات، الاستعلام، *المعطيات):
        """ينفّذ أمرا (إنشاء، إدخال، تحديث، حذف...) ويعيد عدد الصفوف المتأثرة.

        المعطيات تحل محل علامات ؟ بالترتيب: ق.نفذ("... القيم (؟، ؟)"، "أحمد"، ١٦)
        """
        مؤشر = ذات._نفذ_مباشرة(_ترجم(الاستعلام)، _معطيات(المعطيات)، الاستعلام)
        ذات.آخر_معرف = مؤشر.lastrowid
        إذا ليس ذات._اتصال.in_transaction:
            _تخزين.persist()
        أرجع أكبر(مؤشر.rowcount، ٠)

    دالة نفذ_عدة(ذات، الاستعلام، قائمة_المعطيات):
        """ينفّذ الأمر نفسه لكل مجموعة معطيات (لإدخال صفوف كثيرة دفعة واحدة)."""
        مؤشر = ذات._نفذ_مباشرة(_ترجم(الاستعلام)، [_معطيات((م،)) لكل م في قائمة_المعطيات]،
                                 الاستعلام، متعدد=صح)
        إذا ليس ذات._اتصال.in_transaction:
            _تخزين.persist()
        أرجع أكبر(مؤشر.rowcount، ٠)

    دالة نفذ_الكل(ذات، النص):
        """ينفّذ عدة أوامر مفصولة بـ ؛ (مثل ملف لإنشاء الجداول)."""
        حاول:
            ذات._اتصال.executescript(_ترجم(النص))
        باستثناء _sqlite.Error باسم خ:
            ارفع خطأ_قاعدة_بيانات(_عرب(نص(خ)، النص)) من لاشيء
        _تخزين.persist()

    # -- الاستعلام -----------------------------------------------------------
    دالة استعلم(ذات، الاستعلام، *المعطيات):
        """يعيد قائمة الصفوف الناتجة. كل صف يُقرأ بالاسم: صف_["الاسم"]"""
        مؤشر = ذات._نفذ_مباشرة(_ترجم(الاستعلام)، _معطيات(المعطيات)، الاستعلام)
        أرجع [صف_بيانات(قاموس(ص)) لكل ص في مؤشر.fetchall()]

    دالة استعلم_واحدا(ذات، الاستعلام، *المعطيات):
        """يعيد أول صف فقط، أو لاشيء إن لم توجد نتائج."""
        مؤشر = ذات._نفذ_مباشرة(_ترجم(الاستعلام)، _معطيات(المعطيات)، الاستعلام)
        ص = مؤشر.fetchone()
        أرجع صف_بيانات(قاموس(ص)) إذا ص هو ليس لاشيء وإلا لاشيء

    دالة قيمة(ذات، الاستعلام، *المعطيات):
        """يعيد قيمة واحدة: ق.قيمة("اختر عد(*) من الطلاب")"""
        مؤشر = ذات._نفذ_مباشرة(_ترجم(الاستعلام)، _معطيات(المعطيات)، الاستعلام)
        ص = مؤشر.fetchone()
        أرجع ص[٠] إذا ص هو ليس لاشيء وإلا لاشيء

    # -- معلومات -------------------------------------------------------------
    دالة الجداول(ذات):
        """أسماء الجداول في القاعدة."""
        صفوف = ذات._اتصال.execute(
            "SELECT name FROM sqlite_master WHERE type = 'table' "
            "AND name NOT LIKE 'sqlite_%' ORDER BY name").fetchall()
        أرجع [ص[٠] لكل ص في صفوف]

    دالة أعمدة(ذات، الجدول):
        """أسماء أعمدة جدول."""
        صفوف = ذات._نفذ_مباشرة(f'PRAGMA table_info("{الجدول}")').fetchall()
        إذا ليس صفوف:
            ارفع خطأ_قاعدة_بيانات(f"لا يوجد جدول باسم «{الجدول}»")
        أرجع [ص[1] لكل ص في صفوف]

    # -- المعاملات والإغلاق ---------------------------------------------------
    # -- النماذج ---------------------------------------------------------------
    دالة _اكتب(ذات، sql، المعطيات=()):
        مؤشر = ذات._نفذ_مباشرة(sql، المعطيات، اعرض_الاستعلام=خطأ)
        إذا ليس ذات._اتصال.in_transaction:
            _تخزين.persist()
        أرجع مؤشر

    دالة أنشئ_جداول(ذات، *النماذج):
        """ينشئ جداول النماذج إن لم تكن موجودة، ويربطها بهذه القاعدة.

        إن أضفت عمودا جديدا لنموذج موجود، يُضاف إلى الجدول تلقائيا.
        """
        لكل النموذج في النماذج:
            النموذج._القاعدة = ذات
            جدول_ = _اسم(النموذج.اسم_الجدول)
            تعريفات = ", ".اربط(ع._تعريف() لكل ع في النموذج._الأعمدة.القيم())
            ذات._نفذ_مباشرة(f"CREATE TABLE IF NOT EXISTS {جدول_} ({تعريفات})")
            موجودة = {ص[1] لكل ص في ذات._نفذ_مباشرة(f"PRAGMA table_info({جدول_})").fetchall()}
            لكل اسم_العمود، ع في النموذج._الأعمدة.العناصر():
                إذا اسم_العمود ليس في موجودة:
                    ذات._نفذ_مباشرة(f"ALTER TABLE {جدول_} ADD COLUMN {ع._تعريف(للإضافة=صح)}")
                إذا ع.فهرس:
                    ذات._نفذ_مباشرة(
                        f"CREATE INDEX IF NOT EXISTS {_اسم('فهرس_' + النموذج.اسم_الجدول + '_' + اسم_العمود)} "
                        f"ON {جدول_} ({_اسم(اسم_العمود)})")
        _تخزين.persist()

    دالة معاملة(ذات):
        """مع ق.معاملة(): ... كل الأوامر تُعتمد معا أو تُلغى كلها عند الخطأ."""
        أرجع _معاملة(ذات)

    دالة أغلق(ذات):
        ذات._اتصال.close()
        _تخزين.persist()

    دالة __دخول__(ذات):
        أرجع ذات

    دالة __خروج__(ذات، *معطيات):
        ذات.أغلق()

    دالة __تمثيل__(ذات):
        أرجع f"<قاعدة_بيانات «{ذات.الاسم}»>"


دالة احذف_قاعدة(الاسم):
    """يحذف ملف قاعدة البيانات نهائيا."""
    مسار = _تخزين.resolve(الاسم)
    إذا مسار != ":memory:" و _os.path.exists(مسار):
        _os.remove(مسار)
        _تخزين.persist()


# ===========================================================================
# النماذج: جداول على شكل أصناف، واستعلامات على شكل دوال متسلسلة (ORM)
#
#     صنف طالب(نموذج):
#         الاسم = عمود_نص(مطلوب=صح)
#         العمر = عمود_عدد_صحيح()
#
#     ق.أنشئ_جداول(طالب)
#     طالب.أنشئ(الاسم="أحمد"، العمر=١٦)
#     طالب.حيث(طالب.العمر > ١٥).رتب(-طالب.العمر).الكل()
# ===========================================================================
استورد datetime باسم _تاريخ_ووقت


دالة _اسم(الاسم):
    """اسم جدول أو عمود بين علامتي تنصيص: آمن مع العربية والكلمات المحجوزة."""
    أرجع '"' + نص(الاسم).استبدل('"'، '""') + '"'


صنف _تعبير:
    """شرط في استعلام، مثل: طالب.العمر > ١٥

    تُجمع الشروط بـ & (و)، و | (أو)، و ~ (ليس):
        طالب.حيث((طالب.العمر > ١٥) & (طالب.المدينة == "وهران"))
    """

    دالة __تهيئة__(ذات، sql، المعطيات=()):
        ذات.sql = sql
        ذات.المعطيات = صف(المعطيات)

    دالة __و__(ذات، آخر):
        أرجع _تعبير(f"({ذات.sql}) AND ({آخر.sql})"، ذات.المعطيات + آخر.المعطيات)

    دالة __أو__(ذات، آخر):
        أرجع _تعبير(f"({ذات.sql}) OR ({آخر.sql})"، ذات.المعطيات + آخر.المعطيات)

    دالة __عكس_البتات__(ذات):
        أرجع _تعبير(f"NOT ({ذات.sql})"، ذات.المعطيات)

    دالة __منطقي__(ذات):
        ارفع خطأ_نوع(
            "لا يمكن ربط شروط الاستعلام بـ «و» و«أو» و«ليس»: استخدم & و | و ~ "
            "مع الأقواس، مثل: (طالب.العمر > ١٥) & (طالب.المدينة == 'وهران')")

    دالة __تمثيل__(ذات):
        أرجع f"<شرط {ذات.sql} {قائمة(ذات.المعطيات)}>"


صنف _ترتيب:
    دالة __تهيئة__(ذات، العمود، تنازلي=خطأ):
        ذات.العمود = العمود
        ذات.تنازلي = تنازلي

    دالة sql(ذات):
        أرجع _اسم(ذات.العمود.الاسم) + (" DESC" إذا ذات.تنازلي وإلا " ASC")


صنف عمود:
    """الأساس المشترك لأعمدة النماذج.

    الخيارات: مطلوب=صح (لا يقبل فارغا)، فريد=صح (لا تكرار)،
    افتراضي=قيمة (أو دالة تُستدعى عند الإنشاء)، فهرس=صح (بحث أسرع).
    """

    _نوع_sql = "TEXT"

    دالة __تهيئة__(ذات، مطلوب=خطأ، فريد=خطأ، افتراضي=لاشيء، فهرس=خطأ):
        ذات.مطلوب = مطلوب
        ذات.فريد = فريد
        ذات.افتراضي = افتراضي
        ذات.فهرس = فهرس
        ذات.الاسم = لاشيء

    دالة __تعيين_الاسم__(ذات، المالك، الاسم):
        ذات.الاسم = الاسم

    دالة __جلب__(ذات، الكائن، المالك=لاشيء):
        إذا الكائن هو لاشيء:
            أرجع ذات          # على الصنف: العمود نفسه، لبناء الشروط
        أرجع الكائن._قيم.احصل(ذات.الاسم)

    دالة __تعيين__(ذات، الكائن، القيمة):
        # نحوّل القيمة إلى نوع العمود فورا: الكائن الجديد مثل المقروء من القاعدة
        الكائن._قيم[ذات.الاسم] = ذات._من_القاعدة(ذات._إلى_القاعدة(القيمة))

    # -- التحويل بين بايثون والقاعدة --------------------------------------------
    دالة _إلى_القاعدة(ذات، القيمة):
        أرجع القيمة

    دالة _من_القاعدة(ذات، القيمة):
        أرجع القيمة

    دالة _قيمة_افتراضية(ذات):
        أرجع ذات.افتراضي() إذا قابل_للاستدعاء(ذات.افتراضي) وإلا ذات.افتراضي

    دالة _تعريف(ذات، للإضافة=خطأ):
        أجزاء = [_اسم(ذات.الاسم)، ذات._نوع_sql]
        # SQLite لا تسمح بإضافة عمود مطلوب أو فريد إلى جدول موجود
        إذا ذات.مطلوب و ليس للإضافة:
            أجزاء.أضف("NOT NULL")
        إذا ذات.فريد و ليس للإضافة:
            أجزاء.أضف("UNIQUE")
        أرجع " ".اربط(أجزاء)

    # -- الشروط ------------------------------------------------------------------
    دالة _قارن(ذات، العامل، القيمة):
        اسم_ = _اسم(ذات.الاسم)
        إذا القيمة هو لاشيء و العامل في ("="، "!="):
            أرجع _تعبير(f"{اسم_} IS {'NOT ' إذا العامل == '!=' وإلا ''}NULL")
        أرجع _تعبير(f"{اسم_} {العامل} ?"، [ذات._إلى_القاعدة(القيمة)])

    دالة __يساوي__(ذات، القيمة):
        أرجع ذات._قارن("="، القيمة)

    دالة __لا_يساوي__(ذات، القيمة):
        أرجع ذات._قارن("!="، القيمة)

    دالة __أصغر__(ذات، القيمة):
        أرجع ذات._قارن("<"، القيمة)

    دالة __أصغر_أو_يساوي__(ذات، القيمة):
        أرجع ذات._قارن("<="، القيمة)

    دالة __أكبر__(ذات، القيمة):
        أرجع ذات._قارن(">"، القيمة)

    دالة __أكبر_أو_يساوي__(ذات، القيمة):
        أرجع ذات._قارن(">="، القيمة)

    __تجزئة__ = كائن.__تجزئة__

    دالة ضمن(ذات، القائمة):
        """العمود قيمته إحدى القيم: طالب.المدينة.ضمن(["وهران"، "عنابة"])"""
        قيم_ = [ذات._إلى_القاعدة(ق) لكل ق في القائمة]
        إذا ليس قيم_:
            أرجع _تعبير("0")
        أرجع _تعبير(f"{_اسم(ذات.الاسم)} IN ({', '.اربط('?' لكل _ في قيم_)})"، قيم_)

    دالة يشبه(ذات، النمط):
        """نمط بعلامة %: طالب.الاسم.يشبه("أ%") لكل اسم يبدأ بـ أ"""
        أرجع _تعبير(f"{_اسم(ذات.الاسم)} LIKE ?"، [النمط])

    دالة يحتوي(ذات، النص_):
        أرجع ذات.يشبه(f"%{النص_}%")

    دالة يبدأ_ب(ذات، النص_):
        أرجع ذات.يشبه(f"{النص_}%")

    دالة ينتهي_ب(ذات، النص_):
        أرجع ذات.يشبه(f"%{النص_}")

    دالة بين(ذات، الأدنى، الأعلى):
        أرجع _تعبير(f"{_اسم(ذات.الاسم)} BETWEEN ? AND ?"،
                     [ذات._إلى_القاعدة(الأدنى)، ذات._إلى_القاعدة(الأعلى)])

    دالة فارغ(ذات):
        أرجع ذات._قارن("="، لاشيء)

    دالة ليس_فارغا(ذات):
        أرجع ذات._قارن("!="، لاشيء)

    # -- الترتيب ------------------------------------------------------------------
    دالة تصاعديا(ذات):
        أرجع _ترتيب(ذات)

    دالة تنازليا(ذات):
        أرجع _ترتيب(ذات، تنازلي=صح)

    دالة __سالب__(ذات):
        أرجع _ترتيب(ذات، تنازلي=صح)

    دالة __تمثيل__(ذات):
        أرجع f"<{نوع(ذات).__اسم__} {ذات.الاسم}>"


صنف عمود_نص(عمود):
    """عمود نصي."""
    _نوع_sql = "TEXT"

    دالة _إلى_القاعدة(ذات، القيمة):
        أرجع لاشيء إذا القيمة هو لاشيء وإلا نص(القيمة)


صنف عمود_عدد_صحيح(عمود):
    """عمود للأعداد الصحيحة."""
    _نوع_sql = "INTEGER"

    دالة _إلى_القاعدة(ذات، القيمة):
        أرجع لاشيء إذا القيمة هو لاشيء وإلا عدد_صحيح(القيمة)


صنف عمود_عدد_عشري(عمود):
    """عمود للأعداد العشرية."""
    _نوع_sql = "REAL"

    دالة _إلى_القاعدة(ذات، القيمة):
        أرجع لاشيء إذا القيمة هو لاشيء وإلا عدد_عشري(القيمة)


صنف عمود_منطقي(عمود):
    """عمود قيمته صح أو خطأ."""
    _نوع_sql = "INTEGER"

    دالة _إلى_القاعدة(ذات، القيمة):
        أرجع لاشيء إذا القيمة هو لاشيء وإلا (١ إذا القيمة وإلا ٠)

    دالة _من_القاعدة(ذات، القيمة):
        أرجع لاشيء إذا القيمة هو لاشيء وإلا منطقي(القيمة)


صنف عمود_تاريخ(عمود):
    """عمود لتاريخ أو تاريخ ووقت. تلقائي=صح يضع وقت الإنشاء."""
    _نوع_sql = "TEXT"

    دالة __تهيئة__(ذات، تلقائي=خطأ، افتراضي=لاشيء، **الخيارات):
        # «افتراضي» معامل مسمى لا مفتاح نص: أسماء المعاملات تُترجم، والنصوص لا
        إذا تلقائي و افتراضي هو لاشيء:
            افتراضي = لامدا: _تاريخ_ووقت.datetime.now().replace(microsecond=٠)
        الأب().__تهيئة__(افتراضي=افتراضي، **الخيارات)

    دالة _إلى_القاعدة(ذات، القيمة):
        إذا القيمة هو لاشيء:
            أرجع لاشيء
        أرجع القيمة.isoformat(sep=" ") إذا من_نوع(القيمة، _تاريخ_ووقت.datetime) وإلا نص(
            القيمة.isoformat() إذا لديه_خاصية(القيمة، "isoformat") وإلا القيمة)

    دالة _من_القاعدة(ذات، القيمة):
        إذا ليس من_نوع(القيمة، نص):
            أرجع القيمة
        حاول:
            إذا طول(القيمة) == ١٠:
                أرجع _تاريخ_ووقت.date.fromisoformat(القيمة)
            أرجع _تاريخ_ووقت.datetime.fromisoformat(القيمة)
        باستثناء خطأ_قيمة:
            أرجع القيمة


_عند_الحذف = {"تتالي": "CASCADE"، "فارغ": "SET NULL"، "امنع": "RESTRICT"}


صنف عمود_مرجع(عمود):
    """عمود يشير إلى صف في نموذج آخر (مفتاح خارجي).

        صنف درجة(نموذج):
            الطالب = عمود_مرجع(طالب)

    د.الطالب يعيد كائن الطالب نفسه. عند_الحذف: «تتالي» (يُحذف معه)، أو «فارغ»، أو «امنع».
    """
    _نوع_sql = "INTEGER"

    دالة __تهيئة__(ذات، النموذج، عند_الحذف="تتالي"، **الخيارات):
        الأب().__تهيئة__(**الخيارات)
        ذات.النموذج = النموذج
        ذات.عند_الحذف = _عند_الحذف.احصل(عند_الحذف، "CASCADE")

    دالة _تعريف(ذات، للإضافة=خطأ):
        أرجع (الأب()._تعريف(للإضافة) + f" REFERENCES {_اسم(ذات.النموذج.اسم_الجدول)}"
               f"({_اسم('المعرف')}) ON DELETE {ذات.عند_الحذف}")

    دالة _إلى_القاعدة(ذات، القيمة):
        إذا من_نوع(القيمة، نموذج):
            أرجع القيمة.المعرف
        أرجع القيمة

    دالة __جلب__(ذات، الكائن، المالك=لاشيء):
        إذا الكائن هو لاشيء:
            أرجع ذات
        معرف_ = الكائن._قيم.احصل(ذات.الاسم)
        إذا معرف_ هو لاشيء:
            أرجع لاشيء
        مخزن = الكائن._مراجع.احصل(ذات.الاسم)
        إذا مخزن هو لاشيء أو مخزن.المعرف != معرف_:
            مخزن = ذات.النموذج.احصل(معرف_)
            الكائن._مراجع[ذات.الاسم] = مخزن
        أرجع مخزن

    دالة __تعيين__(ذات، الكائن، القيمة):
        إذا من_نوع(القيمة، نموذج):
            الكائن._مراجع[ذات.الاسم] = القيمة
        الكائن._قيم[ذات.الاسم] = ذات._إلى_القاعدة(القيمة)


صنف _عمود_المعرف(عمود_عدد_صحيح):
    دالة _تعريف(ذات، للإضافة=خطأ):
        أرجع f"{_اسم(ذات.الاسم)} INTEGER PRIMARY KEY AUTOINCREMENT"


# ---------------------------------------------------------------------------
# الاستعلامات المتسلسلة
# ---------------------------------------------------------------------------
صنف استعلام:
    """استعلام على نموذج، يُبنى خطوة خطوة ولا يُنفَّذ حتى تطلب النتائج:

        طالب.حيث(طالب.العمر > ١٥).رتب(-طالب.العمر).حد(١٠).الكل()
    """

    دالة __تهيئة__(ذات، النموذج):
        ذات.النموذج = النموذج
        ذات._الشروط = []
        ذات._الترتيب = []
        ذات._الحد = لاشيء
        ذات._التخطي = لاشيء

    دالة _نسخة(ذات):
        جديد = استعلام(ذات.النموذج)
        جديد._الشروط = قائمة(ذات._الشروط)
        جديد._الترتيب = قائمة(ذات._الترتيب)
        جديد._الحد = ذات._الحد
        جديد._التخطي = ذات._التخطي
        أرجع جديد

    # -- البناء -------------------------------------------------------------------
    دالة حيث(ذات، *الشروط، **التساوي):
        """يصفّي النتائج: حيث(طالب.العمر > ١٥) أو حيث(المدينة="وهران")"""
        جديد = ذات._نسخة()
        لكل شرط في الشروط:
            إذا ليس من_نوع(شرط، _تعبير):
                ارفع خطأ_نوع(f"«حيث» تنتظر شرطا مثل طالب.العمر > ١٥، لا {شرط!r}")
            جديد._الشروط.أضف(شرط)
        لكل الاسم، القيمة في التساوي.العناصر():
            جديد._الشروط.أضف(ذات.النموذج._عمود(الاسم) == القيمة)
        أرجع جديد

    دالة رتب(ذات، *الأعمدة):
        """رتب(طالب.العمر) تصاعديا، رتب(-طالب.العمر) تنازليا، أو بالاسم: رتب("-العمر")"""
        جديد = ذات._نسخة()
        لكل ع في الأعمدة:
            إذا من_نوع(ع، نص):
                تنازلي = ع.يبدأ_ب("-")
                ع = _ترتيب(ذات.النموذج._عمود(ع.شذب_يسار("-"))، تنازلي)
            وإلا إذا من_نوع(ع، عمود):
                ع = _ترتيب(ع)
            جديد._الترتيب.أضف(ع)
        أرجع جديد

    دالة حد(ذات، العدد):
        """أول عدد من النتائج فقط."""
        جديد = ذات._نسخة()
        جديد._الحد = عدد_صحيح(العدد)
        أرجع جديد

    دالة تخطى(ذات، العدد):
        """يتخطى عددا من النتائج (للتقسيم إلى صفحات)."""
        جديد = ذات._نسخة()
        جديد._التخطي = عدد_صحيح(العدد)
        أرجع جديد

    # -- توليد SQL ------------------------------------------------------------------
    دالة _الشرط(ذات):
        إذا ليس ذات._الشروط:
            أرجع ""، ()
        معطيات = ()
        لكل شرط في ذات._الشروط:
            معطيات += شرط.المعطيات
        أرجع " WHERE " + " AND ".اربط(f"({ش.sql})" لكل ش في ذات._الشروط)، معطيات

    دالة _اختر(ذات، الأعمدة="*"):
        الشرط، معطيات = ذات._الشرط()
        sql = f"SELECT {الأعمدة} FROM {_اسم(ذات.النموذج.اسم_الجدول)}{الشرط}"
        إذا ذات._الترتيب:
            sql += " ORDER BY " + ", ".اربط(ت.sql() لكل ت في ذات._الترتيب)
        إذا ذات._الحد هو ليس لاشيء أو ذات._التخطي هو ليس لاشيء:
            sql += " LIMIT ? OFFSET ?"
            معطيات += (ذات._الحد إذا ذات._الحد هو ليس لاشيء وإلا -١، ذات._التخطي أو ٠)
        أرجع sql، معطيات

    دالة _نفذ(ذات، sql، معطيات، كتابة=خطأ):
        القاعدة = ذات.النموذج._قاعدة()
        إذا كتابة:
            أرجع القاعدة._اكتب(sql، معطيات)
        أرجع القاعدة._نفذ_مباشرة(sql، معطيات، اعرض_الاستعلام=خطأ)

    # -- النتائج ----------------------------------------------------------------------
    دالة الكل(ذات):
        """قائمة بكل النتائج."""
        مؤشر = ذات._نفذ(*ذات._اختر())
        أرجع [ذات.النموذج._من_صف(ص) لكل ص في مؤشر.fetchall()]

    دالة أول(ذات):
        """أول نتيجة، أو لاشيء."""
        نتائج = ذات.حد(١).الكل()
        أرجع نتائج[٠] إذا نتائج وإلا لاشيء

    دالة عد(ذات):
        """عدد النتائج."""
        sql، معطيات = ذات._اختر()
        أرجع ذات._نفذ(f"SELECT COUNT(*) FROM ({sql})"، معطيات).fetchone()[٠]

    دالة موجود(ذات):
        """هل توجد نتيجة واحدة على الأقل؟"""
        أرجع ذات.أول() هو ليس لاشيء

    دالة _تجميع(ذات، الدالة، العمود):
        الشرط، معطيات = ذات._الشرط()
        sql = f"SELECT {الدالة}({_اسم(العمود.الاسم)}) FROM {_اسم(ذات.النموذج.اسم_الجدول)}{الشرط}"
        أرجع ذات._نفذ(sql، معطيات).fetchone()[٠]

    دالة مجموع(ذات، العمود):
        أرجع ذات._تجميع("SUM"، العمود)

    دالة متوسط(ذات، العمود):
        أرجع ذات._تجميع("AVG"، العمود)

    دالة أكبر(ذات، العمود):
        أرجع ذات._تجميع("MAX"، العمود)

    دالة أصغر(ذات، العمود):
        أرجع ذات._تجميع("MIN"، العمود)

    # -- التعديل الجماعي --------------------------------------------------------------
    دالة حدث(ذات، **القيم_):
        """يعدّل كل النتائج دفعة واحدة، ويعيد عددها: طالب.حيث(...).حدث(العمر=١٧)"""
        إذا ليس القيم_:
            أرجع ٠
        أعمدة = [(ذات.النموذج._عمود(الاسم)، القيمة) لكل الاسم، القيمة في القيم_.العناصر()]
        الشرط، معطيات = ذات._الشرط()
        التعيين = ", ".اربط(f"{_اسم(ع.الاسم)} = ?" لكل ع، _ في أعمدة)
        sql = f"UPDATE {_اسم(ذات.النموذج.اسم_الجدول)} SET {التعيين}{الشرط}"
        قيم = صف(ع._إلى_القاعدة(ق) لكل ع، ق في أعمدة)
        أرجع ذات._نفذ(sql، قيم + معطيات، كتابة=صح).rowcount

    دالة أزل(ذات):
        """يحذف كل النتائج، ويعيد عددها."""
        الشرط، معطيات = ذات._الشرط()
        sql = f"DELETE FROM {_اسم(ذات.النموذج.اسم_الجدول)}{الشرط}"
        أرجع ذات._نفذ(sql، معطيات، كتابة=صح).rowcount

    دالة __مكرر__(ذات):
        أرجع مكرر(ذات.الكل())

    دالة __طول__(ذات):
        أرجع ذات.عد()

    دالة __تمثيل__(ذات):
        sql، معطيات = ذات._اختر()
        أرجع f"<استعلام {sql} {قائمة(معطيات)}>"


# ---------------------------------------------------------------------------
# النموذج
# ---------------------------------------------------------------------------
صنف نموذج:
    """الأساس لنماذج قواعد البيانات: كل صنف يرثه جدول، وكل عمود فيه خاصية.

    لكل نموذج عمود «المعرف» تلقائيا (رقم فريد يزيد تلقائيا).
    اسم الجدول هو اسم الصنف، ويمكن تغييره: اسم_الجدول = "الطلاب"
    """

    اسم_الجدول = لاشيء
    _القاعدة = لاشيء
    _الأعمدة = {}
    المعرف = _عمود_المعرف()

    دالة __تهيئة_صنف_فرعي__(الصنف، **الخيارات):
        الأب().__تهيئة_صنف_فرعي__(**الخيارات)
        أعمدة = {"المعرف": نموذج.المعرف}
        لكل أصل_ في معكوسة(الصنف.__mro__):
            لكل الاسم، القيمة في أصل_.__قاموس__.العناصر():
                إذا من_نوع(القيمة، عمود) و الاسم != "المعرف":
                    أعمدة[الاسم] = القيمة
        الصنف._الأعمدة = أعمدة
        إذا "اسم_الجدول" ليس في الصنف.__قاموس__:
            الصنف.اسم_الجدول = الصنف.__اسم__

    دالة __تهيئة__(ذات، **القيم_):
        ذات._قيم = {}
        ذات._مراجع = {}
        لكل الاسم، ع في نوع(ذات)._الأعمدة.العناصر():
            قيمة = القيم_.انزع(الاسم) إذا الاسم في القيم_ وإلا ع._قيمة_افتراضية()
            عين_خاصية(ذات، الاسم، قيمة)
        إذا القيم_:
            غريب = "، ".اربط(القيم_)
            ارفع خطأ_خاصية(f"لا يوجد عمود باسم «{غريب}» في النموذج «{نوع(ذات).__اسم__}»")

    # -- الربط بالقاعدة -------------------------------------------------------------
    @دالة_صنف
    دالة _قاعدة(الصنف):
        إذا الصنف._القاعدة هو لاشيء:
            ارفع خطأ_قاعدة_بيانات(
                f"النموذج «{الصنف.__اسم__}» غير مربوط بقاعدة بيانات. "
                f"اربطه أولا: ق.أنشئ_جداول({الصنف.__اسم__})")
        أرجع الصنف._القاعدة

    @دالة_صنف
    دالة _عمود(الصنف، الاسم):
        ع = الصنف._الأعمدة.احصل(الاسم)
        إذا ع هو لاشيء:
            ارفع خطأ_خاصية(f"لا يوجد عمود باسم «{الاسم}» في النموذج «{الصنف.__اسم__}»")
        أرجع ع

    @دالة_صنف
    دالة _من_صف(الصنف، الصف_):
        كائن_ = الصنف.__إنشاء__(الصنف)
        كائن_._قيم = {}
        كائن_._مراجع = {}
        لكل الاسم، ع في الصنف._الأعمدة.العناصر():
            إذا الاسم في الصف_.keys():
                كائن_._قيم[الاسم] = ع._من_القاعدة(الصف_[الاسم])
        أرجع كائن_

    # -- الاستعلامات (اختصارات على الصنف) ----------------------------------------------
    @دالة_صنف
    دالة استعلام(الصنف):
        أرجع استعلام(الصنف)

    @دالة_صنف
    دالة حيث(الصنف، *الشروط، **التساوي):
        أرجع استعلام(الصنف).حيث(*الشروط، **التساوي)

    @دالة_صنف
    دالة رتب(الصنف، *الأعمدة):
        أرجع استعلام(الصنف).رتب(*الأعمدة)

    @دالة_صنف
    دالة الكل(الصنف):
        أرجع استعلام(الصنف).الكل()

    @دالة_صنف
    دالة عد(الصنف):
        أرجع استعلام(الصنف).عد()

    @دالة_صنف
    دالة أول(الصنف):
        أرجع استعلام(الصنف).رتب(الصنف.المعرف).أول()

    @دالة_صنف
    دالة احصل(الصنف، *الشروط، **التساوي):
        """صف واحد، أو لاشيء إن لم يوجد:

            طالب.احصل(٣)                        ← بالمعرف
            طالب.احصل(الاسم="أحمد")             ← بقيم الأعمدة
            طالب.احصل(طالب.الاسم.يبدأ_ب("أ"))   ← بشرط
        """
        استعلام_ = استعلام(الصنف).حيث(**التساوي)
        لكل شرط في الشروط:
            استعلام_ = استعلام_.حيث(شرط إذا من_نوع(شرط، _تعبير) وإلا الصنف.المعرف == شرط)
        أرجع استعلام_.رتب(الصنف.المعرف).أول()

    @دالة_صنف
    دالة أنشئ(الصنف، **القيم_):
        """ينشئ صفا جديدا ويحفظه: طالب.أنشئ(الاسم="أحمد"، العمر=١٦)"""
        أرجع الصنف(**القيم_).احفظ()

    @دالة_صنف
    دالة أنشئ_عدة(الصنف، القائمة):
        """ينشئ عدة صفوف دفعة واحدة من قائمة قواميس."""
        مع الصنف._قاعدة().معاملة():
            أرجع [الصنف.أنشئ(**قيم_) لكل قيم_ في القائمة]

    # -- الكائن الواحد ------------------------------------------------------------------
    دالة احفظ(ذات):
        """يحفظ الكائن: يُدرج إن كان جديدا، ويُحدَّث إن كان محفوظا."""
        الصنف = نوع(ذات)
        القاعدة = الصنف._قاعدة()
        أعمدة = [(الاسم، ع) لكل الاسم، ع في الصنف._الأعمدة.العناصر() إذا الاسم != "المعرف"]
        قيم = صف(ع._إلى_القاعدة(ذات._قيم.احصل(الاسم)) لكل الاسم، ع في أعمدة)
        جدول_ = _اسم(الصنف.اسم_الجدول)
        إذا ذات.المعرف هو لاشيء:
            الأسماء = ", ".اربط(_اسم(الاسم) لكل الاسم، _ في أعمدة)
            علامات = ", ".اربط("?" لكل _ في أعمدة)
            مؤشر = القاعدة._اكتب(f"INSERT INTO {جدول_} ({الأسماء}) VALUES ({علامات})"، قيم)
            ذات._قيم["المعرف"] = مؤشر.lastrowid
        وإلا:
            التعيين = ", ".اربط(f"{_اسم(الاسم)} = ?" لكل الاسم، _ في أعمدة)
            القاعدة._اكتب(f"UPDATE {جدول_} SET {التعيين} WHERE {_اسم('المعرف')} = ?"،
                          قيم + (ذات.المعرف،))
        أرجع ذات

    دالة أزل(ذات):
        """يحذف الكائن من القاعدة."""
        إذا ذات.المعرف هو ليس لاشيء:
            نوع(ذات).حيث(نوع(ذات).المعرف == ذات.المعرف).أزل()
            ذات._قيم["المعرف"] = لاشيء

    دالة أعد_التحميل(ذات):
        """يقرأ القيم من القاعدة من جديد."""
        حديث = نوع(ذات).احصل(ذات.المعرف)
        إذا حديث هو لاشيء:
            ارفع خطأ_قاعدة_بيانات(f"الصف رقم {ذات.المعرف} لم يعد موجودا")
        ذات._قيم = حديث._قيم
        ذات._مراجع = {}
        أرجع ذات

    دالة كقاموس(ذات):
        """القيم على شكل قاموس (المراجع تظهر بمعرّفها)."""
        أرجع {الاسم: ذات._قيم.احصل(الاسم) لكل الاسم في نوع(ذات)._الأعمدة}

    دالة __يساوي__(ذات، آخر):
        أرجع (نوع(ذات) هو نوع(آخر) و ذات.المعرف هو ليس لاشيء و ذات.المعرف == آخر.المعرف)

    دالة __تجزئة__(ذات):
        أرجع تجزئة((نوع(ذات).__اسم__، ذات.المعرف إذا ذات.المعرف هو ليس لاشيء وإلا هوية(ذات)))

    دالة __تمثيل__(ذات):
        أجزاء = " ".اربط(f"{الاسم}={القيمة!r}" لكل الاسم، القيمة في ذات.كقاموس().العناصر())
        أرجع f"<{نوع(ذات).__اسم__} {أجزاء}>"
