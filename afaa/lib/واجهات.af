"""واجهات: مكتبة أفعى لبناء تطبيقات ويب تفاعلية بالعربية.

مثال:

    من واجهات استورد *

    عنوان_الصفحة("عدّاد")
    العدد = تسمية("٠")

    دالة زد():
        العدد.النص = نص(عدد_صحيح(العدد.النص) + ١)

    زر("زد واحدا"، عند_الضغط=زد)

العناصر تُضاف إلى الصفحة بترتيب إنشائها. لترتيبها استخدم الحاويات:

    مع أفقي():
        زر("أ")
        زر("ب")

المكتبة مكتوبة بلغة أفعى نفسها، وتعمل في المتصفح (ساحة أفعى أو تطبيق مستقل).
التوثيق الكامل في docs/gui.md.
"""

من afaa استورد gui_bridge باسم _جسر
من afaa.vocabulary استورد normalize باسم _طبع، ARABIC_TO_PYTHON باسم _القاموس
استورد رياضيات باسم _رياضيات
استورد base64 باسم _ب٦٤
استورد csv باسم _csv
استورد datetime باسم _dt
استورد io باسم _io


# ---------------------------------------------------------------------------
# الألوان والقيم العربية
# ---------------------------------------------------------------------------
_الألوان = {_طبع(اسم): قيمة لكل اسم، قيمة في {
    "أحمر": "#dc2626"، "أخضر": "#16a34a"، "أزرق": "#2563eb"، "أصفر": "#eab308"،
    "برتقالي": "#f97316"، "بنفسجي": "#9333ea"، "وردي": "#ec4899"، "بني": "#92400e"،
    "أسود": "#111827"، "أبيض": "#ffffff"، "رمادي": "#6b7280"، "سماوي": "#06b6d4"،
    "ذهبي": "#d4a017"، "كحلي": "#1e3a8a"، "زيتي": "#4d7c0f"، "فيروزي": "#0d9488"،
    "شفاف": "transparent"،
}.العناصر()}

_المحاذاة = {"يمين": "right"، "وسط": "center"، "يسار": "left"، "ضبط": "justify"}
_أنماط_الأزرار = {"أساسي": "primary"، "ثانوي": "secondary"، "خطر": "danger"، "نجاح": "success"}
_أنواع_التنبيه = {"معلومة": "info"، "نجاح": "success"، "تحذير": "warning"، "خطأ": "error"}


دالة _بايثون(الاسم):
    """الاسم كما يصل من شيفرة المستخدم بعد الترجمة (بعض الكلمات تُترجم إلى الإنجليزية)."""
    أرجع _القاموس.احصل(_طبع(الاسم)، الاسم)


دالة _لون(قيمة):
    """يحوّل اسم اللون العربي إلى لون CSS، ويترك غيره كما هو (مثل #ff0000)."""
    إذا قيمة هو لاشيء:
        أرجع لاشيء
    قيمة = نص(قيمة).شذب()
    أرجع _الألوان.احصل(_طبع(قيمة)، قيمة)


دالة _حدود(قيمة):
    """«أحمر» ← 1px solid لون، و«٢ أزرق» ← 2px solid لون، وصح ← حدود عادية."""
    إذا قيمة هو لاشيء:
        أرجع لاشيء
    إذا قيمة هو صح:
        أرجع "1px solid var(--border)"
    إذا قيمة هو خطأ:
        أرجع "none"
    أجزاء = نص(قيمة).split()
    سمك = "1"
    إذا أجزاء و أجزاء[٠].replace(".", "").isdigit():
        سمك = f"{عدد_عشري(أجزاء.انزع(٠)):g}"
    لون_ = _لون(" ".join(أجزاء)) إذا أجزاء وإلا "var(--border)"
    أرجع f"{سمك}px solid {لون_}"


دالة _عدد(قيمة):
    """يحوّل نص المتصفح إلى عدد صحيح أو عشري (أو لاشيء إن كان فارغا)."""
    إذا قيمة هو لاشيء أو قيمة == "":
        أرجع لاشيء
    عدد_ = عدد_عشري(قيمة)
    أرجع عدد_صحيح(عدد_) إذا عدد_.is_integer() وإلا عدد_


# ---------------------------------------------------------------------------
# العنصر الأساسي
# ---------------------------------------------------------------------------
_الجذر = []      # عناصر الصفحة الرئيسية
_المكدس = []     # الحاويات المفتوحة بـ «مع»


دالة _الحاوية_الحالية():
    أرجع _المكدس[-١] إذا _المكدس وإلا لاشيء


دالة _خاصية(المفتاح، تحويل=لاشيء):
    """خاصية تُرسل قيمتها الجديدة إلى الصفحة عند تغييرها."""
    دالة اجلب(ذات):
        أرجع ذات._خصائص.احصل(المفتاح)

    دالة عين(ذات، قيمة):
        إذا تحويل هو ليس لاشيء و قيمة هو ليس لاشيء:
            قيمة = تحويل(قيمة)
        ذات._خصائص[المفتاح] = قيمة
        _جسر.emit({"op": "set"، "id": ذات._المعرف، "props": {المفتاح: قيمة}})

    أرجع خاصية(اجلب، عين)


صنف عنصر:
    """الأساس المشترك لكل عناصر الواجهة."""

    _النوع = "element"

    دالة __تهيئة__(ذات، داخل=لاشيء، **خصائص):
        ذات._المعرف = _جسر.new_id()
        ذات._خصائص = {م: ق لكل م، ق في خصائص.العناصر() إذا ق هو ليس لاشيء}
        ذات._الأبناء = []
        ذات.الحاوية = داخل إذا داخل هو ليس لاشيء وإلا _الحاوية_الحالية()
        إذا ذات.الحاوية هو لاشيء:
            _الجذر.أضف(ذات)
            معرف_الحاوية = لاشيء
        وإلا:
            ذات.الحاوية._الأبناء.أضف(ذات)
            معرف_الحاوية = ذات.الحاوية._المعرف
        _جسر.register(ذات._المعرف، ذات)
        _جسر.emit({"op": "create"، "id": ذات._المعرف، "kind": ذات._النوع،
                   "parent": معرف_الحاوية، "props": ذات._خصائص})

    مرئي = _خاصية("visible"، منطقي)
    معطل = _خاصية("disabled"، منطقي)

    دالة أظهر(ذات):
        ذات.مرئي = صح
        أرجع ذات

    دالة أخف(ذات):
        ذات.مرئي = خطأ
        أرجع ذات

    دالة عطل(ذات):
        ذات.معطل = صح
        أرجع ذات

    دالة فعل(ذات):
        ذات.معطل = خطأ
        أرجع ذات

    دالة نسق(ذات، اللون=لاشيء، الخلفية=لاشيء، الحجم=لاشيء، عريض=لاشيء،
             المحاذاة=لاشيء، العرض=لاشيء، الارتفاع=لاشيء، الحشو=لاشيء، الهامش=لاشيء،
             الحدود=لاشيء، الزوايا=لاشيء، الظل=لاشيء، الشفافية=لاشيء، مائل=لاشيء، الخط=لاشيء):
        """يغيّر مظهر العنصر. الأطوال بالبكسل، والألوان بالعربية أو بصيغة CSS.

        الحدود: لون («أحمر»)، أو سمك ولون («٢ أزرق»). الزوايا: تدوير الزوايا بالبكسل.
        الظل: صح أو خطأ. الشفافية: من ٠ (مخفي) إلى ١. الخط: «عادي» أو «ثابت» (للشيفرة).
        """
        نمط = قاموس(ذات._خصائص.احصل("style") أو {})
        تغييرات = {
            "color": _لون(اللون)،
            "background": _لون(الخلفية)،
            "fontSize": الحجم،
            "bold": عريض،
            "align": _المحاذاة.احصل(المحاذاة، المحاذاة) إذا المحاذاة وإلا لاشيء،
            "width": العرض،
            "height": الارتفاع،
            "padding": الحشو،
            "margin": الهامش،
            "border": _حدود(الحدود)،
            "radius": الزوايا،
            "shadow": الظل،
            "opacity": الشفافية،
            "italic": مائل،
            "font": {"ثابت": "mono"، "عادي": "sans"}.احصل(الخط، الخط) إذا الخط وإلا لاشيء،
        }
        لكل مفتاح_، قيمة في تغييرات.العناصر():
            إذا قيمة هو ليس لاشيء:
                نمط[مفتاح_] = قيمة
        ذات._خصائص["style"] = نمط
        _جسر.emit({"op": "set"، "id": ذات._المعرف، "props": {"style": نمط}})
        أرجع ذات

    دالة أزل(ذات):
        """يحذف العنصر من الصفحة."""
        قائمة_الأب = ذات.الحاوية._الأبناء إذا ذات.الحاوية هو ليس لاشيء وإلا _الجذر
        إذا ذات في قائمة_الأب:
            قائمة_الأب.أزل(ذات)
        ذات._ألغ_التسجيل()
        _جسر.emit({"op": "remove"، "id": ذات._المعرف})

    دالة _ألغ_التسجيل(ذات):
        لكل ابن في ذات._الأبناء:
            ابن._ألغ_التسجيل()
        ذات._الأبناء = []
        _جسر.unregister(ذات._المعرف)

    دالة _عالج_حدث(ذات، الاسم، البيانات):
        مرر

    دالة __تمثيل__(ذات):
        أرجع f"<{نوع(ذات).__اسم__} {ذات._المعرف}>"


# ---------------------------------------------------------------------------
# الحاويات: ترتيب العناصر
# ---------------------------------------------------------------------------
صنف حاوية(عنصر):
    """عنصر يحتوي عناصر أخرى. استخدمه مع «مع» لإضافة العناصر داخله."""

    دالة __دخول__(ذات):
        _المكدس.أضف(ذات)
        أرجع ذات

    دالة __خروج__(ذات، *معطيات):
        _المكدس.انزع()

    دالة امسح(ذات):
        """يحذف كل العناصر داخل الحاوية."""
        لكل ابن في ذات._الأبناء:
            ابن._ألغ_التسجيل()
        ذات._الأبناء = []
        _جسر.emit({"op": "clear"، "id": ذات._المعرف})


صنف أفقي(حاوية):
    """يرتب العناصر في صف أفقي."""
    _النوع = "row"

    دالة __تهيئة__(ذات، المسافة=لاشيء، داخل=لاشيء):
        الأب().__تهيئة__(داخل، gap=المسافة)


صنف عمودي(حاوية):
    """يرتب العناصر فوق بعضها."""
    _النوع = "column"

    دالة __تهيئة__(ذات، المسافة=لاشيء، داخل=لاشيء):
        الأب().__تهيئة__(داخل، gap=المسافة)


صنف بطاقة(حاوية):
    """إطار بحدود وعنوان اختياري يجمع عناصر مترابطة."""
    _النوع = "card"
    العنوان = _خاصية("title"، نص)

    دالة __تهيئة__(ذات، العنوان=لاشيء، داخل=لاشيء):
        الأب().__تهيئة__(داخل، title=العنوان)


صنف شبكة(حاوية):
    """يرتب العناصر في شبكة بعدد محدد من الأعمدة."""
    _النوع = "grid"

    دالة __تهيئة__(ذات، الأعمدة=٢، المسافة=لاشيء، داخل=لاشيء):
        الأب().__تهيئة__(داخل، columns=الأعمدة، gap=المسافة)


# ---------------------------------------------------------------------------
# عناصر النصوص
# ---------------------------------------------------------------------------
صنف ترويسة(عنصر):
    """عنوان بارز. المستوى من ١ (الأكبر) إلى ٤."""
    _النوع = "heading"
    النص = _خاصية("text"، نص)

    دالة __تهيئة__(ذات، النص=""، المستوى=٢، داخل=لاشيء):
        الأب().__تهيئة__(داخل، text=نص(النص)، level=أصغر(أكبر(عدد_صحيح(المستوى)، ١)، ٤))


صنف تسمية(عنصر):
    """نص يُعرض في الصفحة ويمكن تغييره لاحقا."""
    _النوع = "label"
    النص = _خاصية("text"، نص)

    دالة __تهيئة__(ذات، النص=""، داخل=لاشيء):
        الأب().__تهيئة__(داخل، text=نص(النص))


صنف رابط(عنصر):
    """رابط يُفتح في لسان جديد."""
    _النوع = "link"
    النص = _خاصية("text"، نص)
    الوجهة = _خاصية("href"، نص)

    دالة __تهيئة__(ذات، النص، الوجهة، داخل=لاشيء):
        الأب().__تهيئة__(داخل، text=نص(النص)، href=نص(الوجهة))


صنف صورة(عنصر):
    """صورة من رابط على الإنترنت."""
    _النوع = "image"
    الرابط = _خاصية("src"، نص)

    دالة __تهيئة__(ذات، الرابط، العرض=لاشيء، الوصف=""، داخل=لاشيء):
        الأب().__تهيئة__(داخل، src=نص(الرابط)، width=العرض، alt=نص(الوصف))


صنف خط_فاصل(عنصر):
    """خط أفقي يفصل بين أجزاء الصفحة."""
    _النوع = "divider"

    دالة __تهيئة__(ذات، داخل=لاشيء):
        الأب().__تهيئة__(داخل)


صنف شريط_تقدم(عنصر):
    """شريط يوضح نسبة الإنجاز."""
    _النوع = "progress"
    القيمة = _خاصية("value")
    الأقصى = _خاصية("max")

    دالة __تهيئة__(ذات، القيمة=٠، الأقصى=١٠٠، داخل=لاشيء):
        الأب().__تهيئة__(داخل، value=القيمة، max=الأقصى)


دالة _خلية(قيمة):
    أرجع "" إذا قيمة هو لاشيء وإلا نص(قيمة)


دالة _كقاموس(صف_):
    """كائن نموذج من قواعد_البيانات (له كقاموس) يصبح قاموسا، وغيره يبقى كما هو."""
    تحويل = اجلب_خاصية(صف_، "كقاموس"، لاشيء)
    أرجع تحويل() إذا قابل_للاستدعاء(تحويل) وإلا صف_


دالة _صفوف(الصفوف):
    """قائمة صفوف من أي مصدر: قائمة، أو نتائج استعلام، أو استعلام نماذج."""
    أرجع [_كقاموس(ص) لكل ص في (الصفوف أو [])]


دالة _خلايا(صف_، الأعمدة):
    """صف من قائمة قيم، أو من قاموس (مثل نتائج استعلام قاعدة بيانات)."""
    إذا من_نوع(صف_، قاموس):
        أرجع [_خلية(صف_.احصل(ع)) لكل ع في الأعمدة]
    أرجع [_خلية(ق) لكل ق في صف_]


صنف جدول(عنصر):
    """جدول بيانات بأعمدة وصفوف.

    جدول(["الاسم"، "العمر"]، [["أحمد"، ١٦]])
    جدول(ق.استعلم("اختر * من الطلاب"))   ← الأعمدة من نتائج الاستعلام
    جدول(طالب.حيث(طالب.العمر > ١٥))      ← أو من نماذج قواعد_البيانات

    الفرز بالضغط على عنوان العمود متاح دائما. وأيضا:
        قابل_للبحث=صح      حقل بحث فوق الجدول
        حجم_الصفحة=١٠      تقسيم الصفوف إلى صفحات
        عند_الاختيار=دالة  تُستدعى بالصف المضغوط كما هو (قاموس، أو كائن نموذج، أو قائمة)
    """
    _النوع = "table"
    الأعمدة = _خاصية("columns"، قائمة)

    دالة __تهيئة__(ذات، الأعمدة=لاشيء، الصفوف=لاشيء، عند_الاختيار=لاشيء، قابل_للبحث=خطأ،
                   حجم_الصفحة=لاشيء، قابل_للفرز=صح، داخل=لاشيء):
        ذات.عند_الاختيار = عند_الاختيار
        ذات.المحدد = لاشيء
        إذا الصفوف هو لاشيء و الأعمدة هو ليس لاشيء:
            عينة = _صفوف(الأعمدة)
            إذا عينة و من_نوع(عينة[٠]، قاموس):
                الصفوف، الأعمدة = الأعمدة، لاشيء
        ذات._الأصلية = قائمة(الصفوف) إذا الصفوف هو ليس لاشيء وإلا []
        صفوف = _صفوف(ذات._الأصلية)
        إذا الأعمدة هو لاشيء و صفوف و من_نوع(صفوف[٠]، قاموس):
            الأعمدة = قائمة(صفوف[٠].المفاتيح())
        أعمدة = [نص(ع) لكل ع في (الأعمدة أو [])]
        الأب().__تهيئة__(داخل، columns=أعمدة، rows=[_خلايا(س، أعمدة) لكل س في صفوف]،
                         sortable=منطقي(قابل_للفرز)، searchable=منطقي(قابل_للبحث)،
                         pageSize=حجم_الصفحة، selectable=عند_الاختيار هو ليس لاشيء)

    دالة __تعيين_خاصية__(ذات، الاسم، القيمة):
        كائن.__تعيين_خاصية__(ذات، الاسم، القيمة)
        # تعيين دالة الاختيار لاحقا يجعل الصفوف قابلة للضغط
        إذا الاسم == _بايثون("عند_الاختيار") و "_المعرف" في ذات.__قاموس__:
            ذات._خصائص["selectable"] = القيمة هو ليس لاشيء
            _جسر.emit({"op": "set"، "id": ذات._المعرف، "props": {"selectable": القيمة هو ليس لاشيء}})

    @خاصية
    دالة الصفوف(ذات):
        أرجع [قائمة(س) لكل س في ذات._خصائص["rows"]]

    @الصفوف.setter
    دالة الصفوف(ذات، الصفوف):
        ذات._الأصلية = قائمة(الصفوف أو [])
        ذات.المحدد = لاشيء
        صفوف = _صفوف(ذات._الأصلية)
        إذا صفوف و من_نوع(صفوف[٠]، قاموس) و ليس ذات._خصائص.احصل("columns"):
            ذات.الأعمدة = قائمة(صفوف[٠].المفاتيح())
        أعمدة = ذات._خصائص.احصل("columns") أو []
        ذات._خصائص["rows"] = [_خلايا(س، أعمدة) لكل س في صفوف]
        _جسر.emit({"op": "set"، "id": ذات._المعرف، "props": {"rows": ذات._خصائص["rows"]}})

    دالة اعرض(ذات، الصفوف):
        """يعرض صفوفا جديدة مكان القديمة: جدول.اعرض(ق.استعلم("اختر ..."))"""
        ذات.الصفوف = الصفوف

    دالة أضف_صفا(ذات، *القيم):
        """يضيف صفا جديدا: جدول.أضف_صفا("أحمد"، ٢٠) أو جدول.أضف_صفا({"الاسم": "أحمد"})"""
        مفرد = القيم[٠] إذا طول(القيم) == ١ وإلا لاشيء
        صف_ = مفرد إذا من_نوع(_كقاموس(مفرد)، قاموس) وإلا قائمة(القيم)
        ذات.الصفوف = ذات._الأصلية + [صف_]

    دالة امسح(ذات):
        ذات.الصفوف = []

    دالة _عالج_حدث(ذات، الاسم، البيانات):
        إذا الاسم == "select" و ٠ <= البيانات < طول(ذات._الأصلية):
            ذات.المحدد = ذات._الأصلية[البيانات]
            إذا ذات.عند_الاختيار هو ليس لاشيء:
                _جسر.call_handler(ذات.عند_الاختيار، ذات.المحدد)


# ---------------------------------------------------------------------------
# عناصر التفاعل
# ---------------------------------------------------------------------------
صنف زر(عنصر):
    """زر يستدعي دالة عند الضغط عليه.

    النمط: «أساسي» أو «ثانوي» أو «خطر» أو «نجاح».
    """
    _النوع = "button"
    النص = _خاصية("text"، نص)

    دالة __تهيئة__(ذات، النص=""، عند_الضغط=لاشيء، النمط="أساسي"، داخل=لاشيء):
        ذات.عند_الضغط = عند_الضغط
        الأب().__تهيئة__(داخل، text=نص(النص)، variant=_أنماط_الأزرار.احصل(النمط، "primary"))

    دالة _عالج_حدث(ذات، الاسم، البيانات):
        إذا الاسم == "click" و ذات.عند_الضغط هو ليس لاشيء:
            _جسر.call_handler(ذات.عند_الضغط، ذات)


صنف _عنصر_إدخال(عنصر):
    """الأساس المشترك لعناصر الإدخال: تحفظ قيمتها وتستدعي عند_التغيير."""

    دالة _حول(ذات، قيمة):
        أرجع قيمة

    @خاصية
    دالة القيمة(ذات):
        أرجع ذات._خصائص.احصل("value")

    @القيمة.setter
    دالة القيمة(ذات، قيمة):
        ذات._خصائص["value"] = قيمة
        _جسر.emit({"op": "set"، "id": ذات._المعرف، "props": {"value": قيمة}})

    دالة _عالج_حدث(ذات، الاسم، البيانات):
        إذا الاسم == "change":
            ذات._خصائص["value"] = ذات._حول(البيانات)
            إذا ذات.عند_التغيير هو ليس لاشيء:
                _جسر.call_handler(ذات.عند_التغيير، ذات.القيمة)
        وإلا إذا الاسم == "submit" و اجلب_خاصية(ذات، "عند_الإرسال"، لاشيء) هو ليس لاشيء:
            _جسر.call_handler(ذات.عند_الإرسال، ذات.القيمة)


صنف حقل_نص(_عنصر_إدخال):
    """حقل لكتابة سطر نصي. عند_الإرسال تُستدعى عند ضغط Enter."""
    _النوع = "textinput"

    دالة __تهيئة__(ذات، تلميح=""، القيمة=""، عند_التغيير=لاشيء، عند_الإرسال=لاشيء،
                   سري=خطأ، داخل=لاشيء):
        ذات.عند_التغيير = عند_التغيير
        ذات.عند_الإرسال = عند_الإرسال
        الأب().__تهيئة__(داخل، placeholder=نص(تلميح)، value=نص(القيمة)، password=منطقي(سري))


صنف منطقة_نص(_عنصر_إدخال):
    """حقل لكتابة نص طويل متعدد الأسطر."""
    _النوع = "textarea"

    دالة __تهيئة__(ذات، تلميح=""، القيمة=""، الأسطر=٤، عند_التغيير=لاشيء، داخل=لاشيء):
        ذات.عند_التغيير = عند_التغيير
        الأب().__تهيئة__(داخل، placeholder=نص(تلميح)، value=نص(القيمة)، rows=الأسطر)


صنف حقل_عدد(_عنصر_إدخال):
    """حقل لإدخال الأعداد. القيمة عدد (أو لاشيء إن كان فارغا)."""
    _النوع = "number"

    دالة __تهيئة__(ذات، القيمة=٠، الأدنى=لاشيء، الأقصى=لاشيء، الخطوة=١،
                   عند_التغيير=لاشيء، داخل=لاشيء):
        ذات.عند_التغيير = عند_التغيير
        الأب().__تهيئة__(داخل، value=القيمة، min=الأدنى، max=الأقصى، step=الخطوة)

    دالة _حول(ذات، قيمة):
        حاول:
            أرجع _عدد(قيمة)
        باستثناء خطأ_قيمة:
            أرجع لاشيء


صنف منزلق(_عنصر_إدخال):
    """شريط منزلق لاختيار عدد بين حدين."""
    _النوع = "slider"

    دالة __تهيئة__(ذات، الأدنى=٠، الأقصى=١٠٠، القيمة=لاشيء، الخطوة=١،
                   عند_التغيير=لاشيء، داخل=لاشيء):
        ذات.عند_التغيير = عند_التغيير
        إذا القيمة هو لاشيء:
            القيمة = الأدنى
        الأب().__تهيئة__(داخل، value=القيمة، min=الأدنى، max=الأقصى، step=الخطوة)

    دالة _حول(ذات، قيمة):
        أرجع _عدد(قيمة)


صنف مربع_اختيار(_عنصر_إدخال):
    """مربع يُحدَّد أو يُلغى تحديده. القيمة صح أو خطأ."""
    _النوع = "checkbox"
    النص = _خاصية("text"، نص)

    دالة __تهيئة__(ذات، النص=""، محدد=خطأ، عند_التغيير=لاشيء، داخل=لاشيء):
        ذات.عند_التغيير = عند_التغيير
        الأب().__تهيئة__(داخل، text=نص(النص)، value=منطقي(محدد))

    دالة _حول(ذات، قيمة):
        أرجع منطقي(قيمة)

    @خاصية
    دالة محدد(ذات):
        أرجع ذات.القيمة


صنف قائمة_منسدلة(_عنصر_إدخال):
    """قائمة لاختيار عنصر واحد من عدة خيارات."""
    _النوع = "select"
    الخيارات = _خاصية("options"، لامدا خ: [نص(ع) لكل ع في خ])

    دالة __تهيئة__(ذات، الخيارات، القيمة=لاشيء، عند_التغيير=لاشيء، داخل=لاشيء):
        ذات.عند_التغيير = عند_التغيير
        خيارات = [نص(ع) لكل ع في الخيارات]
        إذا القيمة هو لاشيء و خيارات:
            القيمة = خيارات[٠]
        الأب().__تهيئة__(داخل، options=خيارات، value=القيمة)


# ---------------------------------------------------------------------------
# عناصر اختيار إضافية
# ---------------------------------------------------------------------------
صنف اختيار_واحد(_عنصر_إدخال):
    """مجموعة خيارات يُختار منها واحد فقط (أزرار دائرية)."""
    _النوع = "radio"
    الخيارات = _خاصية("options"، لامدا خ: [نص(ع) لكل ع في خ])

    دالة __تهيئة__(ذات، الخيارات، القيمة=لاشيء، أفقي=صح، عند_التغيير=لاشيء، داخل=لاشيء):
        ذات.عند_التغيير = عند_التغيير
        خيارات = [نص(ع) لكل ع في الخيارات]
        إذا القيمة هو لاشيء و خيارات:
            القيمة = خيارات[٠]
        الأب().__تهيئة__(داخل، options=خيارات، value=لاشيء إذا القيمة هو لاشيء وإلا نص(القيمة)،
                         horizontal=منطقي(أفقي))


صنف مفتاح_تبديل(مربع_اختيار):
    """مفتاح تشغيل وإيقاف. القيمة صح أو خطأ."""
    _النوع = "switch"

    دالة __تهيئة__(ذات، النص=""، مفعل=خطأ، عند_التغيير=لاشيء، داخل=لاشيء):
        الأب().__تهيئة__(النص، مفعل، عند_التغيير، داخل)


دالة _كتاريخ(قيمة):
    إذا قيمة هو لاشيء أو قيمة == "":
        أرجع لاشيء
    إذا من_نوع(قيمة، _dt.date):
        أرجع قيمة
    أرجع _dt.date.fromisoformat(نص(قيمة)[:١٠])


دالة _كوقت(قيمة):
    إذا قيمة هو لاشيء أو قيمة == "":
        أرجع لاشيء
    إذا من_نوع(قيمة، _dt.time):
        أرجع قيمة
    أرجع _dt.time.fromisoformat(نص(قيمة))


صنف حقل_تاريخ(_عنصر_إدخال):
    """حقل لاختيار تاريخ من تقويم. القيمة تاريخ (datetime.date) أو لاشيء."""
    _النوع = "date"

    دالة __تهيئة__(ذات، القيمة=لاشيء، الأدنى=لاشيء، الأقصى=لاشيء، عند_التغيير=لاشيء، داخل=لاشيء):
        ذات.عند_التغيير = عند_التغيير
        الأب().__تهيئة__(داخل، value=_كتاريخ(القيمة)، min=_كتاريخ(الأدنى)، max=_كتاريخ(الأقصى))

    دالة _حول(ذات، قيمة):
        أرجع _كتاريخ(قيمة)

    @_عنصر_إدخال.القيمة.setter
    دالة القيمة(ذات، قيمة):
        _عنصر_إدخال.القيمة.fset(ذات، _كتاريخ(قيمة))


صنف حقل_وقت(_عنصر_إدخال):
    """حقل لاختيار الساعة والدقيقة. القيمة وقت (datetime.time) أو لاشيء."""
    _النوع = "time"

    دالة __تهيئة__(ذات، القيمة=لاشيء، عند_التغيير=لاشيء، داخل=لاشيء):
        ذات.عند_التغيير = عند_التغيير
        الأب().__تهيئة__(داخل، value=_كوقت(القيمة))

    دالة _حول(ذات، قيمة):
        أرجع _كوقت(قيمة)


صنف منتقي_لون(_عنصر_إدخال):
    """حقل لاختيار لون. القيمة لون بصيغة ‎#rrggbb‎."""
    _النوع = "color"

    دالة __تهيئة__(ذات، القيمة="أزرق"، عند_التغيير=لاشيء، داخل=لاشيء):
        ذات.عند_التغيير = عند_التغيير
        الأب().__تهيئة__(داخل، value=_لون(القيمة))


# ---------------------------------------------------------------------------
# الملفات: الرفع من جهاز الزائر، والتنزيل إليه
# ---------------------------------------------------------------------------
صنف ملف_مرفوع:
    """ملف اختاره المستخدم: الاسم، والنوع، والحجم (بالبايت)، والمحتوى (bytes)."""

    دالة __تهيئة__(ذات، الاسم، النوع، الحجم، المحتوى):
        ذات.الاسم = الاسم
        ذات.النوع = النوع
        ذات.الحجم = الحجم
        ذات.المحتوى = المحتوى

    دالة كنص(ذات، الترميز="utf-8"):
        """محتوى الملف نصا."""
        أرجع ذات.المحتوى.فك_الرمز(الترميز، errors="replace").lstrip("﻿")

    دالة كصفوف(ذات، الفاصل=لاشيء):
        """ملف CSV كقائمة قواميس (السطر الأول أسماء الأعمدة)، جاهزة لـ جدول أو رسم_بياني."""
        النص = ذات.كنص()
        إذا الفاصل هو لاشيء:
            أول_سطر = النص.قسم_أسطر()[٠] إذا النص وإلا ""
            الفاصل = "؛" إذا "؛" في أول_سطر وإلا (";" إذا ";" في أول_سطر و "," ليس في أول_سطر وإلا ",")
        أرجع [قاموس(ص) لكل ص في _csv.DictReader(_io.StringIO(النص)، delimiter=الفاصل)]

    دالة __تمثيل__(ذات):
        أرجع f"<ملف_مرفوع {ذات.الاسم} ({ذات.الحجم} بايت)>"


صنف رفع_ملف(عنصر):
    """زر لاختيار ملف (أو عدة ملفات) من جهاز المستخدم.

    عند_الرفع تُستدعى بالملف (ملف_مرفوع)، أو بقائمة ملفات إن كان متعددا.
    الأنواع تحدد الملفات المسموحة، مثل ".csv,.txt" أو "image/*".
    """
    _النوع = "file"
    النص = _خاصية("text"، نص)

    دالة __تهيئة__(ذات، النص="📂 اختر ملفا"، عند_الرفع=لاشيء، الأنواع=لاشيء، متعدد=خطأ، داخل=لاشيء):
        ذات.عند_الرفع = عند_الرفع
        ذات.الملفات = []
        الأب().__تهيئة__(داخل، text=نص(النص)، accept=الأنواع، multiple=منطقي(متعدد))

    دالة _عالج_حدث(ذات، الاسم، البيانات):
        إذا الاسم != "upload":
            أرجع
        ذات.الملفات = [ملف_مرفوع(م["name"]، م["type"]، م["size"]، _ب٦٤.b64decode(م["data"]))
                        لكل م في البيانات]
        إذا ذات.عند_الرفع هو ليس لاشيء و ذات.الملفات:
            قيمة = ذات.الملفات إذا ذات._خصائص.احصل("multiple") وإلا ذات.الملفات[٠]
            _جسر.call_handler(ذات.عند_الرفع، قيمة)


دالة _كـcsv(الصفوف):
    الصفوف = _صفوف(الصفوف)
    مخرج = _io.StringIO()
    إذا الصفوف و من_نوع(الصفوف[٠]، قاموس):
        كاتب = _csv.DictWriter(مخرج، fieldnames=قائمة(الصفوف[٠].المفاتيح()))
        كاتب.writeheader()
        كاتب.writerows(الصفوف)
    وإلا:
        _csv.writer(مخرج).writerows(الصفوف)
    أرجع مخرج.getvalue()


دالة نزل_ملف(اسم_الملف، المحتوى، النوع=لاشيء):
    """ينزّل ملفا إلى جهاز المستخدم.

    المحتوى نص، أو bytes، أو قائمة صفوف (قواميس أو قوائم) فيُحفظ ملف CSV يفتحه Excel.
    """
    _جسر.new_id()
    إذا من_نوع(المحتوى، (bytes، bytearray)):
        بيانات = بايتات(المحتوى)
        النوع = النوع أو "application/octet-stream"
    وإلا:
        إذا ليس من_نوع(المحتوى، نص):
            المحتوى = _كـcsv(المحتوى)
            النوع = النوع أو "text/csv"
        # علامة BOM: تجعل Excel يقرأ العربية في ملفات CSV صحيحة
        بيانات = (("﻿" إذا (النوع أو "").startswith("text/csv") وإلا "") + المحتوى).encode("utf-8")
        النوع = (النوع أو "text/plain") + ";charset=utf-8"
    _جسر.emit({"op": "download"، "name": نص(اسم_الملف)، "type": النوع،
               "data": _ب٦٤.b64encode(بيانات).decode("ascii")})


# ---------------------------------------------------------------------------
# الألسنة والنوافذ المنبثقة
# ---------------------------------------------------------------------------
صنف _لسان(حاوية):
    _النوع = "tab"
    العنوان = _خاصية("title"، نص)

    دالة __تهيئة__(ذات، العنوان، الألسنة):
        الأب().__تهيئة__(الألسنة، title=نص(العنوان))


صنف ألسنة(عنصر):
    """صفحات فرعية يُنتقل بينها بالضغط على عناوينها.

        الطلاب، الإحصاءات = ألسنة(["الطلاب"، "الإحصاءات"])
        مع الطلاب:
            ...

    عند_التغيير تُستدعى بعنوان اللسان المختار.
    """
    _النوع = "tabs"

    دالة __تهيئة__(ذات، العناوين=()، عند_التغيير=لاشيء، داخل=لاشيء):
        ذات.عند_التغيير = عند_التغيير
        ذات.الألواح = []
        الأب().__تهيئة__(داخل، selected=٠)
        لكل عنوان_ في العناوين:
            ذات.لسان(عنوان_)

    دالة لسان(ذات، العنوان):
        """يضيف لسانا جديدا ويعيده (حاوية تُملأ بـ «مع»)."""
        لوح = _لسان(العنوان، ذات)
        ذات.الألواح.أضف(لوح)
        أرجع لوح

    @خاصية
    دالة الحالي(ذات):
        """رقم اللسان المختار (يبدأ من ٠). غيّره للانتقال إلى لسان آخر."""
        أرجع ذات._خصائص.احصل("selected"، ٠)

    @الحالي.setter
    دالة الحالي(ذات، رقم):
        إذا من_نوع(رقم، _لسان):
            رقم = ذات.الألواح.فهرس(رقم)
        ذات._خصائص["selected"] = رقم
        _جسر.emit({"op": "set"، "id": ذات._المعرف، "props": {"selected": رقم}})

    دالة __مكرر__(ذات):
        أرجع مكرر(ذات.الألواح)

    دالة __جلب_عنصر__(ذات، رقم):
        أرجع ذات.الألواح[رقم]

    دالة __طول__(ذات):
        أرجع طول(ذات.الألواح)

    دالة _عالج_حدث(ذات، الاسم، البيانات):
        إذا الاسم == "change":
            ذات._خصائص["selected"] = البيانات
            إذا ذات.عند_التغيير هو ليس لاشيء:
                _جسر.call_handler(ذات.عند_التغيير، ذات.الألواح[البيانات].العنوان)


صنف نافذة_حوار(حاوية):
    """نافذة تظهر فوق الصفحة. تُملأ بـ «مع» ثم تُفتح بـ .افتح() وتُغلق بـ .أغلق()

        ن = نافذة_حوار("تعديل الطالب")
        مع ن:
            حقل_الاسم = حقل_نص()
            زر("احفظ"، لامدا: ن.أغلق())
        زر("عدّل"، لامدا: ن.افتح())
    """
    _النوع = "dialog"
    العنوان = _خاصية("title"، نص)

    دالة __تهيئة__(ذات، العنوان=""، عند_الإغلاق=لاشيء، داخل=لاشيء):
        ذات.عند_الإغلاق = عند_الإغلاق
        الأب().__تهيئة__(داخل، title=نص(العنوان)، open=خطأ)

    @خاصية
    دالة مفتوحة(ذات):
        أرجع منطقي(ذات._خصائص.احصل("open"))

    دالة افتح(ذات):
        ذات._خصائص["open"] = صح
        _جسر.emit({"op": "set"، "id": ذات._المعرف، "props": {"open": صح}})
        أرجع ذات

    دالة أغلق(ذات):
        إذا ذات.مفتوحة:
            ذات._خصائص["open"] = خطأ
            _جسر.emit({"op": "set"، "id": ذات._المعرف، "props": {"open": خطأ}})
            إذا ذات.عند_الإغلاق هو ليس لاشيء:
                _جسر.call_handler(ذات.عند_الإغلاق)
        أرجع ذات

    دالة _عالج_حدث(ذات، الاسم، البيانات):
        # أغلقها المستخدم بزر ✕ أو بمفتاح Esc
        إذا الاسم == "close":
            ذات.أغلق()


دالة أكد(الرسالة، عند_الموافقة، العنوان="تأكيد"، نص_الموافقة="نعم"، نص_الإلغاء="إلغاء"):
    """يسأل المستخدم قبل تنفيذ أمر مهم، ويستدعي عند_الموافقة إن وافق.

        زر("احذف"، لامدا: أكد("هل تريد الحذف؟"، احذف_الكل))
    """
    المكدس_السابق = قائمة(_المكدس)
    _المكدس.امسح()          # النافذة في الصفحة نفسها، لا داخل الحاوية المفتوحة الآن
    حاول:
        نافذة = نافذة_حوار(العنوان)
        مع نافذة:
            تسمية(الرسالة)
            مع أفقي():
                دالة وافق():
                    نافذة.أغلق()
                    _جسر.call_handler(عند_الموافقة)
                زر(نص_الموافقة، وافق)
                زر(نص_الإلغاء، لامدا: نافذة.أغلق()، النمط="ثانوي")
    أخيرا:
        _المكدس.مدد(المكدس_السابق)
    نافذة.عند_الإغلاق = لامدا: نافذة.أزل()
    أرجع نافذة.افتح()


# ---------------------------------------------------------------------------
# الرسوم البيانية
# ---------------------------------------------------------------------------
_أنواع_الرسوم = {"أعمدة": "bar"، "خطي": "line"، "مساحي": "area"، "دائري": "pie"، "حلقي": "donut"}


دالة _بيانات_الرسم(البيانات، التسميات، س، ص):
    """يوحّد صيغ البيانات إلى: تسميات، وسلاسل [{name، values}]."""
    إذا من_نوع(البيانات، قاموس):
        قيم = قائمة(البيانات.القيم())
        إذا قيم و الكل(من_نوع(ق، (قائمة، صف)) لكل ق في قيم):
            # {"السلسلة": [قيم...]} مع التسميات
            طول_ = أكبر(طول(ق) لكل ق في قيم)
            التسميات = قائمة(التسميات) إذا التسميات هو ليس لاشيء وإلا قائمة(مدى(١، طول_ + ١))
            أرجع التسميات، [{"name": نص(م)، "values": قائمة(ق)} لكل م، ق في البيانات.العناصر()]
        # {"تسمية": قيمة}
        أرجع قائمة(البيانات.المفاتيح())، [{"name": ""، "values": قيم}]
    صفوف = _صفوف(البيانات)
    إذا صفوف و من_نوع(صفوف[٠]، قاموس):
        # صفوف قاعدة بيانات: س عمود التسميات، وص عمود (أو أعمدة) القيم
        أعمدة = قائمة(صفوف[٠].المفاتيح())
        س = س أو أعمدة[٠]
        ص = ص أو [ع لكل ع في أعمدة إذا ع != س]
        ص = [ص] إذا من_نوع(ص، نص) وإلا قائمة(ص)
        أرجع [ر[س] لكل ر في صفوف]، [{"name": نص(ع)، "values": [ر[ع] لكل ر في صفوف]} لكل ع في ص]
    # قائمة قيم مجردة
    التسميات = قائمة(التسميات) إذا التسميات هو ليس لاشيء وإلا قائمة(مدى(١، طول(صفوف) + ١))
    أرجع التسميات، [{"name": ""، "values": صفوف}]


صنف رسم_بياني(عنصر):
    """رسم بياني تفاعلي: أعمدة، أو خطي، أو مساحي، أو دائري، أو حلقي.

        رسم_بياني({"يناير": ١٢، "فبراير": ١٩})                       ← سلسلة واحدة
        رسم_بياني({"٢٠٢٥": [...]، "٢٠٢٦": [...]}، التسميات=الأشهر، النوع="خطي")
        رسم_بياني(ق.استعلم("اختر الصنف، عد(*) باسم العدد ...")، س="الصنف"، ص="العدد")
    """
    _النوع = "chart"
    العنوان = _خاصية("title"، نص)

    دالة __تهيئة__(ذات، البيانات، النوع="أعمدة"، العنوان=لاشيء، التسميات=لاشيء، س=لاشيء، ص=لاشيء،
                   الارتفاع=٣٠٠، مكدس=خطأ، داخل=لاشيء):
        ذات._س، ذات._ص، ذات._التسميات = س، ص، التسميات
        تسميات، سلاسل = _بيانات_الرسم(البيانات، التسميات، س، ص)
        الأب().__تهيئة__(داخل، chart=_أنواع_الرسوم.احصل(النوع، النوع)، title=العنوان،
                         labels=[نص(ت) لكل ت في تسميات]، series=ذات._أرقام(سلاسل)،
                         height=الارتفاع، stacked=منطقي(مكدس))

    دالة _أرقام(ذات، سلاسل):
        دالة رقم(ق):
            حاول:
                أرجع عدد_عشري(ق) إذا ق هو ليس لاشيء و ق != "" وإلا لاشيء
            باستثناء (خطأ_نوع، خطأ_قيمة):
                أرجع لاشيء
        أرجع [{"name": س_["name"]، "values": [رقم(ق) لكل ق في س_["values"]]} لكل س_ في سلاسل]

    دالة اعرض(ذات، البيانات، التسميات=لاشيء):
        """يعرض بيانات جديدة: رسم.اعرض({"أ": ١، "ب": ٢})"""
        تسميات، سلاسل = _بيانات_الرسم(البيانات، التسميات أو ذات._التسميات، ذات._س، ذات._ص)
        props = {"labels": [نص(ت) لكل ت في تسميات]، "series": ذات._أرقام(سلاسل)}
        ذات._خصائص.update(props)
        _جسر.emit({"op": "set"، "id": ذات._المعرف، "props": props})

    @خاصية
    دالة النوع(ذات):
        أرجع ذات._خصائص["chart"]

    @النوع.setter
    دالة النوع(ذات، النوع):
        ذات._خصائص["chart"] = _أنواع_الرسوم.احصل(النوع، النوع)
        _جسر.emit({"op": "set"، "id": ذات._المعرف، "props": {"chart": ذات._خصائص["chart"]}})


# ---------------------------------------------------------------------------
# لوحة الرسم
# ---------------------------------------------------------------------------
# أحداث الفأرة (واللمس) على لوحة الرسم: الاسم في المكتبة ← اسم الحدث في المتصفح
_أحداث_اللوحة = {_بايثون(ع): إ لكل ع، إ في {
    "عند_الضغط": "click"، "عند_الضغط_لأسفل": "down"، "عند_التحريك": "move"،
    "عند_السحب": "drag"، "عند_الإفلات": "up"،
}.العناصر()}


صنف لوحة_رسم(عنصر):
    """مساحة للرسم. نقطة الأصل (٠، ٠) في الزاوية العليا اليسرى.

    أحداث الفأرة (واللمس)، وكل دالة تأخذ إحداثيي النقطة (س، ص):
        عند_الضغط          نقرة كاملة
        عند_الضغط_لأسفل    بداية الضغط
        عند_السحب          الحركة والزر مضغوط (للرسم الحر)
        عند_التحريك        كل حركة للفأرة فوق اللوحة
        عند_الإفلات        رفع الإصبع أو الزر
    """
    _النوع = "canvas"

    دالة __تهيئة__(ذات، العرض=٤٠٠، الارتفاع=٣٠٠، الخلفية="أبيض"، عند_الضغط=لاشيء،
                   عند_الضغط_لأسفل=لاشيء، عند_التحريك=لاشيء، عند_السحب=لاشيء،
                   عند_الإفلات=لاشيء، داخل=لاشيء):
        # قبل الإنشاء: المتصفح يحتاج معرفة الأحداث المطلوبة من البداية
        كائن.__تعيين_خاصية__(ذات، "_معالجات"، {
            "click": عند_الضغط، "down": عند_الضغط_لأسفل، "move": عند_التحريك،
            "drag": عند_السحب، "up": عند_الإفلات،
        })
        ذات.العرض = العرض
        ذات.الارتفاع = الارتفاع
        ذات.الخلفية = _لون(الخلفية)
        الأب().__تهيئة__(داخل، width=العرض، height=الارتفاع، background=ذات.الخلفية،
                         listen=ذات._المطلوبة())

    دالة _المطلوبة(ذات):
        أرجع [ح لكل ح، د في ذات._معالجات.العناصر() إذا د هو ليس لاشيء]

    دالة __تعيين_خاصية__(ذات، الاسم، القيمة):
        # تغيير دالة حدث بعد الإنشاء: لوحة.عند_السحب = ارسم
        حدث = _أحداث_اللوحة.احصل(الاسم)
        إذا حدث هو لاشيء:
            كائن.__تعيين_خاصية__(ذات، الاسم، القيمة)
            أرجع
        ذات._معالجات[حدث] = القيمة
        إذا "_المعرف" في ذات.__قاموس__:
            _جسر.emit({"op": "set"، "id": ذات._المعرف، "props": {"listen": ذات._المطلوبة()}})

    دالة __جلب_خاصية__(ذات، الاسم):
        حدث = _أحداث_اللوحة.احصل(الاسم)
        إذا حدث هو لاشيء:
            ارفع خطأ_خاصية(الاسم)
        أرجع ذات._معالجات[حدث]

    دالة _ارسم(ذات، *أمر):
        _جسر.emit_draw(ذات._المعرف، قائمة(أمر))
        أرجع ذات

    دالة امسح(ذات):
        """يمسح كل ما رُسم."""
        أرجع ذات._ارسم("clear")

    دالة ارسم_خطا(ذات، س١، ص١، س٢، ص٢، اللون="أسود"، السمك=٢):
        أرجع ذات._ارسم("line"، س١، ص١، س٢، ص٢، _لون(اللون)، السمك)

    دالة ارسم_مستطيلا(ذات، س، ص، العرض، الارتفاع، اللون="أسود"، التعبئة=لاشيء، السمك=٢،
                      الزوايا=٠):
        """الزوايا: نصف قطر تدوير الزوايا بالبكسل."""
        أرجع ذات._ارسم("rect"، س، ص، العرض، الارتفاع، _لون(اللون)، _لون(التعبئة)، السمك، الزوايا)

    دالة ارسم_دائرة(ذات، س، ص، نصف_القطر، اللون="أسود"، التعبئة=لاشيء، السمك=٢):
        أرجع ذات._ارسم("circle"، س، ص، نصف_القطر، _لون(اللون)، _لون(التعبئة)، السمك)

    دالة ارسم_شكلا_بيضويا(ذات، س، ص، نصف_القطر_الأفقي، نصف_القطر_العمودي، اللون="أسود"،
                          التعبئة=لاشيء، السمك=٢):
        أرجع ذات._ارسم("ellipse"، س، ص، نصف_القطر_الأفقي، نصف_القطر_العمودي، _لون(اللون)،
                       _لون(التعبئة)، السمك)

    دالة ارسم_قوسا(ذات، س، ص، نصف_القطر، البداية، النهاية، اللون="أسود"، السمك=٢):
        """قوس من دائرة، والزوايا بالدرجات (٠ يمين المركز، وتزيد مع عقارب الساعة)."""
        أرجع ذات._ارسم("arc"، س، ص، نصف_القطر، البداية، النهاية، _لون(اللون)، السمك)

    دالة ارسم_مضلعا(ذات، النقاط، اللون="أسود"، التعبئة=لاشيء، السمك=٢):
        """النقاط قائمة أزواج: [(س١، ص١)، (س٢، ص٢)، ...]"""
        نقاط = [[س، ص] لكل س، ص في النقاط]
        أرجع ذات._ارسم("poly"، نقاط، _لون(اللون)، _لون(التعبئة)، السمك)

    دالة ارسم_نصا(ذات، النص، س، ص، اللون="أسود"، الحجم=١٦، المحاذاة="وسط"، عريض=خطأ):
        """النص يقبل الرموز التعبيرية أيضا، وهي مفيدة في الألعاب: 🐍 🍎 ⭐"""
        أرجع ذات._ارسم("text"، نص(النص)، س، ص، _لون(اللون)، الحجم،
                       _المحاذاة.احصل(المحاذاة، "center")، منطقي(عريض))

    دالة ارسم_صورة(ذات، الرابط، س، ص، العرض=لاشيء، الارتفاع=لاشيء):
        """يرسم صورة من رابط، وزاويتها العليا اليسرى عند (س، ص).

        الصور من مواقع أخرى تحتاج أن يسمح موقعها بذلك (CORS)، والأسهل صور موقعك نفسه.
        """
        أرجع ذات._ارسم("image"، نص(الرابط)، س، ص، العرض، الارتفاع)

    دالة _عالج_حدث(ذات، الاسم، البيانات):
        # «move» تصل مع حالة الزر: السحب حركة والزر مضغوط
        دوال = [ذات._معالجات.احصل(الاسم)]
        إذا الاسم == "move" و البيانات.احصل("pressed"):
            دوال.أضف(ذات._معالجات.احصل("drag"))
        لكل دالة_ في دوال:
            إذا دالة_ هو ليس لاشيء:
                _جسر.call_handler(دالة_، البيانات["x"]، البيانات["y"])


صنف سلحفاة_رسم:
    """سلحفاة ترسم على لوحة رسم، مثل مكتبة turtle في بايثون.

    تبدأ في منتصف اللوحة متجهة إلى اليمين، والمحور الصادي يتجه للأعلى.
    """

    دالة __تهيئة__(ذات، اللوحة=لاشيء):
        ذات.اللوحة = اللوحة إذا اللوحة هو ليس لاشيء وإلا لوحة_رسم(٤٠٠، ٤٠٠)
        ذات.س = ٠
        ذات.ص = ٠
        ذات.الاتجاه = ٠
        ذات._القلم_نازل = صح
        ذات._اللون = "أسود"
        ذات._السمك = ٢

    دالة _على_اللوحة(ذات، س، ص):
        أرجع ذات.اللوحة.العرض / ٢ + س، ذات.اللوحة.الارتفاع / ٢ - ص

    دالة اذهب_إلى(ذات، س، ص):
        إذا ذات._القلم_نازل:
            س١، ص١ = ذات._على_اللوحة(ذات.س، ذات.ص)
            س٢، ص٢ = ذات._على_اللوحة(س، ص)
            ذات.اللوحة.ارسم_خطا(س١، ص١، س٢، ص٢، ذات._اللون، ذات._السمك)
        ذات.س، ذات.ص = س، ص

    دالة تقدم(ذات، المسافة):
        زاوية = _رياضيات.راديان(ذات.الاتجاه)
        ذات.اذهب_إلى(ذات.س + المسافة * _رياضيات.جتا(زاوية)،
                      ذات.ص + المسافة * _رياضيات.جا(زاوية))

    دالة تراجع(ذات، المسافة):
        ذات.تقدم(-المسافة)

    دالة يسار(ذات، الزاوية):
        ذات.الاتجاه = (ذات.الاتجاه + الزاوية) % ٣٦٠

    دالة يمين(ذات، الزاوية):
        ذات.الاتجاه = (ذات.الاتجاه - الزاوية) % ٣٦٠

    دالة اتجه(ذات، الزاوية):
        ذات.الاتجاه = الزاوية % ٣٦٠

    دالة ارفع_القلم(ذات):
        ذات._القلم_نازل = خطأ

    دالة أنزل_القلم(ذات):
        ذات._القلم_نازل = صح

    دالة لون(ذات، اللون):
        ذات._اللون = اللون

    دالة سمك(ذات، السمك):
        ذات._السمك = السمك

    دالة سرعة(ذات، *معطيات):
        مرر  # الرسم فوري في المتصفح

    دالة دائرة(ذات، نصف_القطر):
        """يرسم دائرة مركزها على يسار السلحفاة، وتعود السلحفاة لمكانها."""
        زاوية = _رياضيات.راديان(ذات.الاتجاه + ٩٠)
        مركز_س = ذات.س + نصف_القطر * _رياضيات.جتا(زاوية)
        مركز_ص = ذات.ص + نصف_القطر * _رياضيات.جا(زاوية)
        إذا ذات._القلم_نازل:
            س، ص = ذات._على_اللوحة(مركز_س، مركز_ص)
            ذات.اللوحة.ارسم_دائرة(س، ص، مطلق(نصف_القطر)، ذات._اللون، لاشيء، ذات._السمك)


# ---------------------------------------------------------------------------
# لوحة المفاتيح
# ---------------------------------------------------------------------------
# أسماء عربية للمفاتيح الخاصة (والحروف والأرقام بأسمائها كما هي)
_المفاتيح_الخاصة = {
    "ArrowUp": "أعلى"، "ArrowDown": "أسفل"، "ArrowLeft": "يسار"، "ArrowRight": "يمين"،
    " ": "مسافة"، "Enter": "إدخال"، "Escape": "هروب"، "Backspace": "حذف"، "Delete": "حذف_أمامي"،
    "Tab": "جدولة"، "Shift": "تبديل"، "Control": "تحكم"، "Alt": "بديل"،
}
_أسماء_المفاتيح = {_طبع(ع): إ لكل إ، ع في _المفاتيح_الخاصة.العناصر()}


دالة _اسم_مفتاح(المفتاح):
    المفتاح = نص(المفتاح)
    أرجع _المفاتيح_الخاصة.احصل(المفتاح، المفتاح.lower() إذا طول(المفتاح) == ١ وإلا المفتاح)


صنف _لوحة_المفاتيح:
    """تستقبل ضغطات لوحة المفاتيح في الصفحة كلها (خارج حقول الكتابة)."""

    دالة __تهيئة__(ذات):
        ذات._المعرف = _جسر.new_id()
        ذات.عند_الضغط = لاشيء
        ذات.عند_الرفع = لاشيء
        ذات.المضغوطة = مجموعة()
        _جسر.register(ذات._المعرف، ذات)
        _جسر.emit({"op": "keys"، "id": ذات._المعرف})

    دالة _عالج_حدث(ذات، الاسم، البيانات):
        إذا الاسم == "blur":
            ذات.المضغوطة.امسح()
            أرجع
        مفتاح_ = _اسم_مفتاح(البيانات["key"])
        إذا الاسم == "keydown":
            ذات.المضغوطة.ضف(مفتاح_)
            إذا ذات.عند_الضغط هو ليس لاشيء:
                _جسر.call_handler(ذات.عند_الضغط، مفتاح_)
        وإلا إذا الاسم == "keyup":
            ذات.المضغوطة.تخلص_من(مفتاح_)
            إذا ذات.عند_الرفع هو ليس لاشيء:
                _جسر.call_handler(ذات.عند_الرفع، مفتاح_)


_المفاتيح = [لاشيء]


دالة _لوحة():
    إذا _المفاتيح[٠] هو لاشيء:
        _المفاتيح[٠] = _لوحة_المفاتيح()
    أرجع _المفاتيح[٠]


دالة عند_ضغط_مفتاح(الدالة):
    """يستدعي الدالة عند ضغط أي مفتاح، مع اسمه: «أعلى» «أسفل» «يمين» «يسار» «مسافة»
    «إدخال» «هروب»، أو الحرف نفسه مثل «a» أو «ب».

    يمكن استخدامها كمزخرف:
        @عند_ضغط_مفتاح
        دالة حرك(المفتاح): ...
    """
    _لوحة().عند_الضغط = الدالة
    أرجع الدالة


دالة عند_رفع_مفتاح(الدالة):
    """يستدعي الدالة عند رفع الإصبع عن مفتاح، مع اسمه."""
    _لوحة().عند_الرفع = الدالة
    أرجع الدالة


دالة مفتاح_مضغوط(المفتاح):
    """هل المفتاح مضغوط الآن؟ مفيدة في الألعاب داخل مؤقت: إذا مفتاح_مضغوط("يمين"): ..."""
    المفتاح = نص(المفتاح)
    أرجع _أسماء_المفاتيح.احصل(_طبع(المفتاح)، المفتاح) في _لوحة().المضغوطة أو \
        _اسم_مفتاح(المفتاح) في _لوحة().المضغوطة


دالة _ابدأ_من_جديد():
    _الجذر.امسح()
    _المكدس.امسح()
    _المفاتيح[٠] = لاشيء


_جسر.on_reset(_ابدأ_من_جديد)


# ---------------------------------------------------------------------------
# المؤقتات
# ---------------------------------------------------------------------------
صنف مؤقت:
    """يستدعي دالة بعد مدة، أو كل مدة. أوقفه بـ مؤقت.أوقف()"""

    دالة __تهيئة__(ذات، الثواني، الدالة، يتكرر=خطأ):
        ذات._المعرف = _جسر.new_id()
        ذات.الدالة = الدالة
        ذات.يتكرر = يتكرر
        ذات.يعمل = صح
        _جسر.register(ذات._المعرف، ذات)
        _جسر.emit({"op": "timer"، "id": ذات._المعرف،
                   "ms": أكبر(١٠، عدد_صحيح(الثواني * ١٠٠٠))، "repeat": منطقي(يتكرر)})

    دالة أوقف(ذات):
        إذا ذات.يعمل:
            ذات.يعمل = خطأ
            _جسر.unregister(ذات._المعرف)
            _جسر.emit({"op": "cancel-timer"، "id": ذات._المعرف})

    دالة _عالج_حدث(ذات، الاسم، البيانات):
        إذا ليس ذات.يعمل:
            أرجع
        إذا ليس ذات.يتكرر:
            ذات.يعمل = خطأ
            _جسر.unregister(ذات._المعرف)
        _جسر.call_handler(ذات.الدالة)


دالة كرر_كل(الثواني، الدالة):
    """يستدعي الدالة كل عدد من الثواني حتى يُوقف المؤقت."""
    أرجع مؤقت(الثواني، الدالة، يتكرر=صح)


دالة بعد_مدة(الثواني، الدالة):
    """يستدعي الدالة مرة واحدة بعد عدد من الثواني."""
    أرجع مؤقت(الثواني، الدالة، يتكرر=خطأ)


# ---------------------------------------------------------------------------
# الصفحة
# ---------------------------------------------------------------------------
دالة عنوان_الصفحة(النص):
    """يضبط عنوان التطبيق (يظهر في لسان المتصفح)."""
    _جسر.new_id()
    _جسر.emit({"op": "page"، "props": {"title": نص(النص)}})


دالة تنبيه(الرسالة، النوع="معلومة"):
    """يعرض رسالة قصيرة تختفي تلقائيا. النوع: معلومة، نجاح، تحذير، خطأ."""
    _جسر.new_id()
    _جسر.emit({"op": "toast"، "text": نص(الرسالة)، "kind": _أنواع_التنبيه.احصل(النوع، "info")})


دالة سمة_الصفحة(اللون=لاشيء، الخلفية=لاشيء، الخط=لاشيء، الوضع=لاشيء):
    """يغيّر مظهر التطبيق كله: اللون الأساسي للأزرار والعناصر، والخلفية، وحجم الخط،
    والوضع «فاتح» أو «داكن».

        سمة_الصفحة(اللون="بنفسجي"، الوضع="داكن")
    """
    _جسر.new_id()
    _جسر.emit({"op": "page"، "props": {"theme": {
        "accent": _لون(اللون)، "background": _لون(الخلفية)، "fontSize": الخط،
        "mode": {"فاتح": "light"، "داكن": "dark"}.احصل(الوضع، الوضع)،
    }}})


دالة امسح_الصفحة():
    """يحذف كل عناصر الصفحة."""
    لكل ع في _الجذر:
        ع._ألغ_التسجيل()
    _الجذر.امسح()
    _جسر.emit({"op": "clear"، "id": لاشيء})


# ---------------------------------------------------------------------------
# الشبكة: جلب بيانات من الإنترنت
# ---------------------------------------------------------------------------
دالة اجلب_نص(الرابط):
    """يجلب محتوى رابط نصا. في المتصفح يجب أن يسمح الموقع بذلك (CORS)."""
    استورد sys
    إذا sys.platform == "emscripten":
        من pyodide.http استورد open_url
        أرجع open_url(نص(الرابط)).getvalue()
    استورد urllib.request
    مع urllib.request.urlopen(نص(الرابط)، timeout=٣٠) باسم استجابة:
        أرجع استجابة.read().فك_الرمز("utf-8"، errors="replace")


دالة اجلب_بيانات(الرابط):
    """يجلب بيانات JSON من رابط (واجهة برمجية) ويعيدها قاموسا أو قائمة."""
    استورد json
    أرجع json.loads(اجلب_نص(الرابط))
