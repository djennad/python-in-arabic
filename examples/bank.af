# حساب بنكي: الأصناف والاستثناءات والخصائص

صنف خطأ_رصيد_غير_كاف(استثناء):
    """يُرفع عند محاولة سحب مبلغ أكبر من الرصيد."""


صنف حساب_بنكي:
    عدد_الحسابات = ٠

    دالة __تهيئة__(ذات، المالك، رصيد_ابتدائي=٠):
        ذات.المالك = المالك
        ذات._رصيد = رصيد_ابتدائي
        ذات.العمليات = []
        حساب_بنكي.عدد_الحسابات += ١

    @خاصية
    دالة الرصيد(ذات):
        أرجع ذات._رصيد

    دالة أودع(ذات، مبلغ):
        إذا مبلغ <= ٠:
            ارفع خطأ_قيمة("يجب أن يكون المبلغ موجبا")
        ذات._رصيد += مبلغ
        ذات.العمليات.أضف(("إيداع"، مبلغ))

    دالة اسحب_مبلغ(ذات، مبلغ):
        إذا مبلغ > ذات._رصيد:
            ارفع خطأ_رصيد_غير_كاف(
                f"الرصيد {ذات._رصيد} لا يكفي لسحب {مبلغ}")
        ذات._رصيد -= مبلغ
        ذات.العمليات.أضف(("سحب"، مبلغ))

    دالة __نص__(ذات):
        أرجع f"حساب {ذات.المالك}: {ذات._رصيد:,} دينار"


حساب = حساب_بنكي("سارة"، ١٠٠٠)
حساب.أودع(٥٠٠)
حساب.اسحب_مبلغ(٢٠٠)

حاول:
    حساب.اسحب_مبلغ(١٠٠٠٠)
باستثناء خطأ_رصيد_غير_كاف باسم خ:
    اطبع("تعذر السحب:"، خ)

اطبع(حساب)
لكل نوع_العملية، مبلغ في حساب.العمليات:
    اطبع(f"  - {نوع_العملية}: {مبلغ}")
اطبع("عدد الحسابات:"، حساب_بنكي.عدد_الحسابات)
