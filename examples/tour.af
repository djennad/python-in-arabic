# جولة في لغة أفعى: كل خصائص بايثون بالعربية

استورد رياضيات
من مجموعات استورد عداد، قاموس_افتراضي
من أصناف_البيانات استورد صنف_بيانات
من أدوات_الدوال استورد ذاكرة_مؤقتة، غلف
استورد تزامن

# ---- المتغيرات والأنواع والأرقام العربية ----
الاسم = «أحمد»
العمر = ٢٥
الطول = ١٫٧٥
مليون = ١٬٠٠٠٬٠٠٠
اطبع(الاسم، العمر، الطول، مليون، فاصل=" | ")
اطبع(f"مرحبا يا {الاسم}، عمرك بعد عشر سنوات: {العمر + ١٠}")
اطبع(f"الجذر التربيعي لـ ١٦ = {رياضيات.جذر(١٦):.1f}، وعدد الأحرف = {طول(الاسم)}")

# ---- الشروط ----
الدرجة = ٨٥
إذا الدرجة >= ٩٠:
    اطبع("ممتاز")
وإلا إذا الدرجة >= ٨٠:
    اطبع("جيد جدا")
وإلا:
    اطبع("جيد")

# ---- الحلقات ----
لكل ع في مدى(١، ٤):
    اطبع(ع، نهاية=" ")
اطبع()

ن = ٣
طالما ن > ٠:
    ن -= ١
    إذا ن == ١:
        استمر
اطبع("انتهت الحلقة", ن)

لكل س في مدى(١٠):
    إذا س == ٢:
        اكسر
وإلا:
    اطبع("لن يُطبع")

# ---- القوائم والقواميس والمجموعات والتضمين ----
أعداد = [٥، ٣، ٨، ١]
أعداد.أضف(٧)
أعداد.رتب(عكسي=صح)
مربعات = [س ** ٢ لكل س في أعداد إذا س % ٢ == ١]
اطبع(أعداد، مربعات)
قاموس_الأعمار = {«علي»: ٣٠، «سارة»: ٢٨}
لكل مفتاح_، قيمة في قاموس_الأعمار.العناصر():
    اطبع(f"{مفتاح_} ← {قيمة}")
اطبع({س % ٣ لكل س في مدى(١٠)})
اطبع(عداد("مرحبا بالعالم").most_common(2))

# ---- الدوال ----
دالة تحية(اسم، تحية="السلام عليكم"، *معطيات، **معطيات_مسماة):
    """دالة بمعاملات افتراضية ومتغيرة."""
    أرجع f"{تحية} يا {اسم}"

اطبع(تحية("خالد"))
مضاعف = لامدا س: س * ٢
اطبع(قائمة(طبق(مضاعف، [١، ٢، ٣])))

@ذاكرة_مؤقتة(maxsize=None)
دالة فيبوناتشي(ن):
    أرجع ن إذا ن < ٢ وإلا فيبوناتشي(ن - ١) + فيبوناتشي(ن - ٢)
اطبع("فيبوناتشي(٣٠) =", فيبوناتشي(٣٠))

دالة مزخرف(دالة_أصلية):
    @غلف(دالة_أصلية)
    دالة غلاف(*معطيات):
        اطبع("قبل الاستدعاء")
        أرجع دالة_أصلية(*معطيات)
    أرجع غلاف

@مزخرف
دالة اجمع_عددين(أ، ب):
    أرجع أ + ب
اطبع(اجمع_عددين(٢، ٣))

# ---- المتغيرات العمومية وغير المحلية ----
عداد_عام = ٠
دالة زد_العداد():
    عمومي عداد_عام
    عداد_عام += ١
زد_العداد()

دالة صانع_عداد():
    ع = ٠
    دالة زد():
        غير_محلي ع
        ع += ١
        أرجع ع
    أرجع زد
ز = صانع_عداد()
ز()
اطبع("العدادان:", عداد_عام، ز())

# ---- الأصناف والوراثة ----
صنف حيوان:
    دالة __تهيئة__(ذات، اسم):
        ذات.اسم = اسم

    دالة تكلم(ذات):
        ارفع خطأ_غير_منفذ

    دالة __نص__(ذات):
        أرجع f"{نوع(ذات).__اسم__}({ذات.اسم})"

صنف قطة(حيوان):
    دالة __تهيئة__(ذات، اسم، لون_الفرو):
        الأب().__تهيئة__(اسم)
        ذات.لون_الفرو = لون_الفرو

    دالة تكلم(ذات):
        أرجع "مياو"

    @خاصية
    دالة وصف(ذات):
        أرجع f"{ذات.اسم} لونها {ذات.لون_الفرو}"

ق = قطة("مشمش"، "برتقالي")
اطبع(ق، ق.تكلم()، ق.وصف، من_نوع(ق، حيوان))

@صنف_بيانات
صنف نقطة:
    س: عدد_صحيح
    ص: عدد_صحيح = ٠

    دالة __جمع__(ذات، أخرى):
        أرجع نقطة(ذات.س + أخرى.س، ذات.ص + أخرى.ص)

اطبع(نقطة(١، ٢) + نقطة(٣، ٤))

# ---- الاستثناءات ----
حاول:
    ١ / ٠
باستثناء خطأ_قسمة_على_صفر باسم خ:
    اطبع("خطأ:", خ)
وإلا:
    اطبع("لا خطأ")
أخيرا:
    اطبع("انتهى")

صنف خطأ_رصيد(استثناء):
    مرر

حاول:
    ارفع خطأ_رصيد("الرصيد غير كاف")
باستثناء (خطأ_قيمة، خطأ_رصيد) باسم خ:
    اطبع(f"التقطنا: {خ!r}")

# ---- المولدات ----
دالة عد_تنازلي(ن):
    طالما ن > ٠:
        أنتج ن
        ن -= ١
اطبع(قائمة(عد_تنازلي(٥)))
اطبع(مجموع(س لكل س في مدى(١٠١)))

# ---- مدير السياق ----
صنف مؤقت:
    دالة __دخول__(ذات):
        اطبع("دخول")
        أرجع ذات
    دالة __خروج__(ذات، *معطيات):
        اطبع("خروج")
مع مؤقت() باسم م:
    اطبع("داخل السياق")

# ---- المطابقة الهيكلية ----
دالة صف_الأمر(أمر):
    طابق أمر.قسم():
        حالة ["اذهب"، اتجاه]:
            أرجع f"الذهاب نحو {اتجاه}"
        حالة ["توقف"]:
            أرجع "توقف"
        حالة _:
            أرجع "أمر غير معروف"
اطبع(صف_الأمر("اذهب شمالا")، صف_الأمر("قفز"))

# ---- عامل الفظ والتفكيك ----
إذا (ن := طول(أعداد)) > ٣:
    اطبع(f"القائمة طويلة ({ن} عناصر)")
أول، *باقي = أعداد
اطبع(أول، باقي)

# ---- البرمجة غير المتزامنة ----
غير_متزامن دالة مهمة(اسم، مدة):
    انتظر تزامن.نم(مدة)
    أرجع f"{اسم} اكتملت"

غير_متزامن دالة رئيسية():
    نتائج = انتظر تزامن.اجمع(مهمة("أ"، ٠٫٠١)، مهمة("ب"، ٠٫٠٢))
    اطبع(نتائج)

تزامن.شغل(رئيسية())

# ---- التأكيد والحذف وليس في / هو ليس ----
تأكد ٩ ليس في أعداد
احذف أعداد[٠]
اطبع(أعداد هو ليس لاشيء، صح و ليس خطأ)

إذا __اسم__ == "__رئيسي__":
    اطبع("تمت الجولة بنجاح ✓")
