# لعبة تخمين العدد: الإدخال والحلقات والشروط
استورد عشوائي

السر = عشوائي.عدد_عشوائي(١، ١٠٠)
المحاولات_المتاحة = ٧
اطبع("فكرت في عدد بين ١ و ١٠٠. لديك", المحاولات_المتاحة, "محاولات لتخمينه!")

لكل محاولة في مدى(١، المحاولات_المتاحة + ١):
    حاول:
        تخمين = عدد_صحيح(أدخل(f"المحاولة {محاولة}: "))
    باستثناء خطأ_قيمة:
        اطبع("من فضلك اكتب عددا صحيحا")
        استمر

    إذا تخمين < السر:
        اطبع("أكبر ⬆")
    وإلا إذا تخمين > السر:
        اطبع("أصغر ⬇")
    وإلا:
        اطبع(f"أحسنت! العدد هو {السر} وعرفته في {محاولة} محاولات 🎉")
        اكسر
وإلا:
    اطبع(f"انتهت المحاولات، العدد كان {السر}")
