# الأعداد الأولية باستخدام غربال إراتوستينس

دالة الأعداد_الأولية(حد):
    """يعيد قائمة الأعداد الأولية الأصغر من «حد»."""
    أولي = [صح] * حد
    أولي[٠] = أولي[١] = خطأ
    لكل ع في مدى(٢، عدد_صحيح(حد ** ٠٫٥) + ١):
        إذا أولي[ع]:
            لكل م في مدى(ع * ع، حد، ع):
                أولي[م] = خطأ
    أرجع [ع لكل ع، هل_أولي في مرقم(أولي) إذا هل_أولي]


إذا __اسم__ == "__رئيسي__":
    نتيجة = الأعداد_الأولية(١٠٠)
    اطبع(f"يوجد {طول(نتيجة)} عددا أوليا أصغر من ١٠٠:")
    اطبع(نتيجة)
