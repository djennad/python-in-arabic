# حاسبة: حقول الأعداد والقوائم والجداول
من واجهات استورد *

عنوان_الصفحة("حاسبة")
ترويسة("حاسبة"، المستوى=١)

العمليات = {
    "جمع +": لامدا أ، ب: أ + ب،
    "طرح −": لامدا أ، ب: أ - ب،
    "ضرب ×": لامدا أ، ب: أ * ب،
    "قسمة ÷": لامدا أ، ب: أ / ب،
    "أس ^": لامدا أ، ب: أ ** ب،
}

مع بطاقة("العملية"):
    مع شبكة(الأعمدة=٣):
        العدد_الأول = حقل_عدد(١٢)
        العملية = قائمة_منسدلة(قائمة(العمليات))
        العدد_الثاني = حقل_عدد(٤)
    النتيجة = تسمية("اضغط «احسب»").نسق(الحجم=٢٢، عريض=صح)


دالة احسب():
    أ، ب = العدد_الأول.القيمة، العدد_الثاني.القيمة
    إذا أ هو لاشيء أو ب هو لاشيء:
        تنبيه("اكتب العددين أولا"، "تحذير")
        أرجع
    حاول:
        ناتج = العمليات[العملية.القيمة](أ، ب)
    باستثناء خطأ_قسمة_على_صفر:
        تنبيه("لا يمكن القسمة على صفر"، "خطأ")
        أرجع
    إذا من_نوع(ناتج، عدد_عشري) و ناتج.is_integer():
        ناتج = عدد_صحيح(ناتج)
    النتيجة.النص = f"النتيجة: {ناتج}"
    السجل.أضف_صفا(أ، العملية.القيمة، ب، ناتج)


زر("احسب"، احسب)

ترويسة("السجل"، المستوى=٣)
السجل = جدول(["الأول"، "العملية"، "الثاني"، "الناتج"])
زر("امسح السجل"، لامدا: السجل.امسح()، النمط="ثانوي")
