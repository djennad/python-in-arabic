# محلل ملفات CSV: رفع ملف من جهازك، وعرضه في جدول ورسم بياني، وتنزيل النتيجة
من واجهات استورد *

عنوان_الصفحة("محلل البيانات")
ترويسة("📊 محلل ملفات CSV"، المستوى=٢)
تسمية("ارفع ملف CSV (السطر الأول أسماء الأعمدة)، أو جرّب البيانات التجريبية.").نسق(اللون="رمادي")

تجريبية = [
    {"الولاية": "الجزائر"، "السكان": ٣٩١٥، "المساحة": ١١٩٠}،
    {"الولاية": "وهران"، "السكان": ١٥٨٤، "المساحة": ٢١١٤}،
    {"الولاية": "قسنطينة"، "السكان": ٩٣٨، "المساحة": ٢١٨٧}،
    {"الولاية": "سطيف"، "السكان": ١٤٨٩، "المساحة": ٦٥٠٤}،
    {"الولاية": "تلمسان"، "السكان": ٩٤٩، "المساحة": ٩٠٦١}،
]
الحالة = {"الصفوف": []}

مع أفقي():
    رفع_ملف("📂 ارفع ملف CSV"، عند_الرفع=لامدا ملف: حمّل(ملف.كصفوف()، ملف.الاسم)، الأنواع=".csv,.txt")
    زر("بيانات تجريبية"، لامدا: حمّل(تجريبية، "بيانات تجريبية")، النمط="ثانوي")

المعلومات = تسمية("")
مع أفقي():
    التسميات = قائمة_منسدلة([]، عند_التغيير=لامدا: ارسم())
    القيم = قائمة_منسدلة([]، عند_التغيير=لامدا: ارسم())
    النوع = اختيار_واحد(["أعمدة"، "خطي"، "دائري"]، عند_التغيير=لامدا: ارسم())
الرسم = رسم_بياني({}، الارتفاع=٢٨٠)
الجدول = جدول([]، قابل_للبحث=صح، حجم_الصفحة=٨)
زر("⬇ نزّل الجدول (CSV)"، لامدا: نزل_ملف("البيانات.csv"، الحالة["الصفوف"])، النمط="ثانوي")


دالة رقمي_(قيمة):
    حاول:
        عدد_عشري(قيمة)
        أرجع صح
    باستثناء (خطأ_قيمة، خطأ_نوع):
        أرجع خطأ


دالة حمّل(الصفوف، المصدر):
    إذا ليس الصفوف:
        تنبيه("الملف فارغ"، "تحذير")
        أرجع
    الحالة["الصفوف"] = الصفوف
    الأعمدة = قائمة(الصفوف[٠].المفاتيح())
    الرقمية = [ع لكل ع في الأعمدة إذا الكل(رقمي_(ص[ع]) لكل ص في الصفوف)] أو الأعمدة
    الجدول.الأعمدة = الأعمدة
    الجدول.اعرض(الصفوف)
    التسميات.الخيارات = الأعمدة
    التسميات.القيمة = الأعمدة[٠]
    القيم.الخيارات = الرقمية
    القيم.القيمة = الرقمية[٠]
    المعلومات.النص = f"{المصدر}: {طول(الصفوف)} صفا و{طول(الأعمدة)} أعمدة"
    ارسم()


دالة ارسم():
    إذا ليس الحالة["الصفوف"]:
        أرجع
    الرسم.النوع = النوع.القيمة
    الرسم.العنوان = f"{القيم.القيمة} حسب {التسميات.القيمة}"
    الرسم.اعرض({ص[التسميات.القيمة]: ص[القيم.القيمة] لكل ص في الحالة["الصفوف"]})


حمّل(تجريبية، "بيانات تجريبية")
