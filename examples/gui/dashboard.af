# لوحة المتجر: ألسنة، ورسوم بيانية، وجدول بالبحث والفرز والاختيار، ونافذة تعديل
من واجهات استورد *

عنوان_الصفحة("لوحة المتجر")
الأشهر = ["يناير"، "فبراير"، "مارس"، "أبريل"، "مايو"، "يونيو"]
المبيعات = {
    "الجزائر": [١٢٠، ١٣٥، ١٦٠، ١٤٨، ١٨٠، ٢١٠]،
    "وهران": [٩٠، ٨٥، ١٠٢، ١٢٠، ١١٥، ١٤٠]،
    "قسنطينة": [٦٠، ٧٢، ٧٠، ٨٨، ٩٥، ١٠٣]،
}
المنتجات = [
    {"المنتج": "تمر دقلة نور"، "الصنف": "أغذية"، "السعر": ٨٠٠، "المخزون": ٥٠}،
    {"المنتج": "زيت زيتون"، "الصنف": "أغذية"، "السعر": ١٢٠٠، "المخزون": ٢٠}،
    {"المنتج": "كتاب الأمير"، "الصنف": "كتب"، "السعر": ١٥٠٠، "المخزون": ٨}،
    {"المنتج": "دفتر"، "الصنف": "أدوات"، "السعر": ١٥٠، "المخزون": ١٢٠}،
    {"المنتج": "قلم حبر"، "الصنف": "أدوات"، "السعر": ٥٠، "المخزون": ٣٠٠}،
    {"المنتج": "زربية"، "الصنف": "تقليدي"، "السعر": ٩٠٠٠، "المخزون": ٣}،
    {"المنتج": "طاجين"، "الصنف": "تقليدي"، "السعر": ٢٥٠٠، "المخزون": ١٥}،
]

مع أفقي():
    ترويسة("🏪 لوحة المتجر"، المستوى=١)
    مفتاح_تبديل("الوضع الداكن"، عند_التغيير=لامدا داكن: سمة_الصفحة(الوضع="داكن" إذا داكن وإلا "فاتح"))

مع شبكة(٣):
    لكل عنوان_، قيمة في [("إجمالي المبيعات"، f"{مجموع(مجموع(ق) لكل ق في المبيعات.القيم()):,} ألف د.ج")،
                          ("عدد المنتجات"، طول(المنتجات))، ("الفروع"، طول(المبيعات))]:
        مع بطاقة():
            تسمية(عنوان_).نسق(اللون="رمادي"، الحجم=١٤)
            تسمية(قيمة).نسق(الحجم=٢٦، عريض=صح)

المبيعات_، المنتجات_ = ألسنة(["📈 المبيعات"، "📦 المنتجات"])

مع المبيعات_:
    النوع = اختيار_واحد(["خطي"، "أعمدة"، "مساحي"]، عند_التغيير=لامدا ن: غير_النوع(ن))
    الرسم = رسم_بياني(المبيعات، النوع="خطي"، التسميات=الأشهر، العنوان="المبيعات الشهرية (ألف د.ج)")
    مع شبكة(٢):
        رسم_بياني({ف: مجموع(ق) لكل ف، ق في المبيعات.العناصر()}، النوع="حلقي"، العنوان="حصة كل فرع"،
                  الارتفاع=٢٤٠)
        رسم_بياني({ف: ق[-١] - ق[٠] لكل ف، ق في المبيعات.العناصر()}، العنوان="النمو منذ يناير"،
                  الارتفاع=٢٤٠)


دالة غير_النوع(النوع):
    الرسم.النوع = النوع


مع المنتجات_:
    تسمية("اضغط على منتج لتعديله. اضغط على عنوان عمود لترتيبه.").نسق(اللون="رمادي"، الحجم=١٤)
    الجدول = جدول(المنتجات، قابل_للبحث=صح، حجم_الصفحة=٥)
    زر("⬇ تنزيل كملف CSV"، لامدا: نزل_ملف("المنتجات.csv"، المنتجات)، النمط="ثانوي")

النافذة = نافذة_حوار("تعديل المنتج")
مع النافذة:
    حقل_السعر = حقل_عدد(الأدنى=٠)
    حقل_المخزون = حقل_عدد(الأدنى=٠)
    مع أفقي():
        زر("احفظ"، لامدا: احفظ_المنتج())
        زر("احذف"، لامدا: أكد("حذف هذا المنتج نهائيا؟"، احذف_المنتج)، النمط="خطر")


دالة اختر_منتجا(المنتج):
    النافذة.العنوان = f"تعديل: {المنتج['المنتج']}"
    حقل_السعر.القيمة = المنتج["السعر"]
    حقل_المخزون.القيمة = المنتج["المخزون"]
    النافذة.افتح()


الجدول.عند_الاختيار = اختر_منتجا


دالة احفظ_المنتج():
    المنتج = الجدول.المحدد
    المنتج["السعر"] = حقل_السعر.القيمة
    المنتج["المخزون"] = حقل_المخزون.القيمة
    الجدول.اعرض(المنتجات)
    النافذة.أغلق()
    تنبيه("حُفظ المنتج"، "نجاح")


دالة احذف_المنتج():
    المنتجات.أزل(الجدول.المحدد)
    الجدول.اعرض(المنتجات)
    النافذة.أغلق()
    تنبيه("حُذف المنتج"، "تحذير")
