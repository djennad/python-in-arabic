# عدّاد: أول تطبيق بمكتبة واجهات
من واجهات استورد *

عنوان_الصفحة("عدّاد")
ترويسة("عدّاد بسيط"، المستوى=١)
تسمية("اضغط الأزرار لتغيير العدد.")

العدد = ٠
الشاشة = تسمية("٠").نسق(الحجم=٥٦، عريض=صح، المحاذاة="وسط")


دالة غير(مقدار):
    عمومي العدد
    العدد += مقدار
    الشاشة.النص = نص(العدد)
    الشاشة.نسق(اللون="أحمر" إذا العدد < ٠ وإلا "فيروزي")


مع أفقي():
    زر("− إنقاص"، لامدا: غير(-١)، النمط="ثانوي")
    زر("تصفير"، لامدا: غير(-العدد)، النمط="خطر")
    زر("+ زيادة"، لامدا: غير(١))
