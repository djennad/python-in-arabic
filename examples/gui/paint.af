# الرسم الحر: السحب بالفأرة أو الإصبع، ومنتقي الألوان، وأشكال بالضغط
من واجهات استورد *

عنوان_الصفحة("رسّام")
ترويسة("🎨 رسّام"، المستوى=٢)

مع أفقي():
    اللون = منتقي_لون("بنفسجي")
    السمك = منزلق(٢، ٣٠، القيمة=٦)
    الأداة = اختيار_واحد(["قلم"، "ممحاة"، "دوائر"، "نجوم"])
    زر("امسح"، لامدا: أكد("هل تريد مسح الرسم؟"، اللوحة.امسح)، النمط="ثانوي")

الحالة = {"آخر": لاشيء}


دالة ابدأ_خطا(س، ص):
    الحالة["آخر"] = (س، ص)
    إذا الأداة.القيمة == "دوائر":
        اللوحة.ارسم_دائرة(س، ص، السمك.القيمة * ٢، اللون=لاشيء، التعبئة=اللون.القيمة)
    وإلا إذا الأداة.القيمة == "نجوم":
        اللوحة.ارسم_نصا("⭐"، س، ص، الحجم=السمك.القيمة * ٤)
    وإلا:
        ارسم_إلى(س، ص)


دالة ارسم_إلى(س، ص):
    إذا الأداة.القيمة ليس في ("قلم"، "ممحاة") أو الحالة["آخر"] هو لاشيء:
        أرجع
    لون = "أبيض" إذا الأداة.القيمة == "ممحاة" وإلا اللون.القيمة
    س١، ص١ = الحالة["آخر"]
    اللوحة.ارسم_خطا(س١، ص١، س، ص، اللون=لون، السمك=السمك.القيمة)
    الحالة["آخر"] = (س، ص)


دالة أنه_الخط():
    الحالة["آخر"] = لاشيء


اللوحة = لوحة_رسم(٦٤٠، ٤٠٠، عند_الضغط_لأسفل=ابدأ_خطا، عند_السحب=ارسم_إلى، عند_الإفلات=أنه_الخط)
تسمية("اسحب على اللوحة للرسم. تعمل باللمس على الهاتف أيضا.").نسق(اللون="رمادي"، الحجم=١٤)
