# الرسم: لوحة الرسم والسلحفاة والنقر بالفأرة
من واجهات استورد *

عنوان_الصفحة("لوحة الرسم")
ترويسة("🎨 لوحة الرسم"، المستوى=١)
تسمية("انقر على اللوحة لترسم، أو اطلب من السلحفاة رسم نجمة.")

مع أفقي():
    اللون = قائمة_منسدلة(["أزرق"، "أحمر"، "أخضر"، "برتقالي"، "بنفسجي"، "أسود"])
    الحجم = منزلق(٥، ٦٠، ٢٠)


دالة ارسم_عند(س، ص):
    لوحة.ارسم_دائرة(س، ص، الحجم.القيمة، اللون=اللون.القيمة، التعبئة=اللون.القيمة)


لوحة = لوحة_رسم(٦٠٠، ٣٦٠، عند_الضغط=ارسم_عند)


دالة نجمة():
    سلحفاة = سلحفاة_رسم(لوحة)
    سلحفاة.لون(اللون.القيمة)
    سلحفاة.سمك(٣)
    سلحفاة.ارفع_القلم()
    سلحفاة.اذهب_إلى(-٩٠، ٣٠)
    سلحفاة.أنزل_القلم()
    لكل _ في مدى(٥):
        سلحفاة.تقدم(١٨٠)
        سلحفاة.يمين(١٤٤)


مع أفقي():
    زر("⭐ نجمة"، نجمة)
    زر("امسح"، لامدا: لوحة.امسح()، النمط="ثانوي")

لوحة.ارسم_نصا("ارسم هنا"، ٣٠٠، ١٨٠، اللون="رمادي"، الحجم=٢٨)
