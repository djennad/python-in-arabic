# ساعة إيقاف: المؤقتات وشريط التقدم
من واجهات استورد *

عنوان_الصفحة("ساعة إيقاف")
ترويسة("⏱ ساعة إيقاف"، المستوى=١)

العشر = ٠          # أعشار الثانية
المؤقت = لاشيء

الشاشة = تسمية("00:00.0").نسق(الحجم=٥٢، عريض=صح، المحاذاة="وسط")
الدقيقة = شريط_تقدم(٠، الأقصى=٦٠٠)


دالة اعرض():
    ثوان، عشر = قسمة_وباقي(العشر، ١٠)
    دقائق، ثوان = قسمة_وباقي(ثوان، ٦٠)
    الشاشة.النص = f"{دقائق:02}:{ثوان:02}.{عشر}"
    الدقيقة.القيمة = العشر % ٦٠٠


دالة نبضة():
    عمومي العشر
    العشر += ١
    اعرض()


دالة ابدأ_أو_أوقف():
    عمومي المؤقت
    إذا المؤقت هو لاشيء:
        المؤقت = كرر_كل(٠٫١، نبضة)
        زر_التشغيل.النص = "⏸ إيقاف مؤقت"
    وإلا:
        المؤقت.أوقف()
        المؤقت = لاشيء
        زر_التشغيل.النص = "▶ متابعة"


دالة صفّر():
    عمومي العشر
    العشر = ٠
    اعرض()


مع أفقي():
    زر_التشغيل = زر("▶ ابدأ"، ابدأ_أو_أوقف)
    زر("تصفير"، صفّر، النمط="ثانوي")
