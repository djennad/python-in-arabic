# مفكرتي: تطبيق ملاحظات بالنماذج (ORM) يحفظ بياناته في المتصفح
من واجهات استورد *
من قواعد_البيانات استورد *

ق = قاعدة_بيانات("مفكرتي")


صنف ملاحظة(نموذج):
    العنوان = عمود_نص(مطلوب=صح)
    المحتوى = عمود_نص()
    مهمة = عمود_منطقي(افتراضي=خطأ)
    التاريخ = عمود_تاريخ(تلقائي=صح)


ق.أنشئ_جداول(ملاحظة)

عنوان_الصفحة("مفكرتي")
ترويسة("🗒️ مفكرتي"، المستوى=١)

مع بطاقة("ملاحظة جديدة"):
    حقل_العنوان = حقل_نص(تلميح="العنوان")
    حقل_المحتوى = منطقة_نص(تلميح="اكتب ملاحظتك…"، الأسطر=٣)
    مع أفقي():
        خانة_المهمة = مربع_اختيار("مهمة يجب إنجازها")
        زر("احفظ"، لامدا: احفظ_ملاحظة())

مع أفقي():
    البحث = حقل_نص(تلميح="🔍 ابحث…"، عند_التغيير=لامدا: اعرض())
    العرض = قائمة_منسدلة(["الكل"، "المهام فقط"، "الملاحظات فقط"]، عند_التغيير=لامدا: اعرض())

الملخص = تسمية("")
القائمة = عمودي()


دالة استعلام_العرض():
    س = ملاحظة.رتب(-ملاحظة.التاريخ، -ملاحظة.المعرف)
    إذا البحث.القيمة:
        س = س.حيث(ملاحظة.العنوان.يحتوي(البحث.القيمة) | ملاحظة.المحتوى.يحتوي(البحث.القيمة))
    إذا العرض.القيمة == "المهام فقط":
        س = س.حيث(مهمة=صح)
    وإلا إذا العرض.القيمة == "الملاحظات فقط":
        س = س.حيث(مهمة=خطأ)
    أرجع س


دالة اعرض():
    القائمة.امسح()
    ملاحظات = استعلام_العرض().الكل()
    لكل م في ملاحظات:
        بطاقة_ = بطاقة(("☐ " إذا م.مهمة وإلا "") + م.العنوان، داخل=القائمة)
        إذا م.المحتوى:
            تسمية(م.المحتوى، داخل=بطاقة_)
        مع أفقي(داخل=بطاقة_):
            تسمية(م.التاريخ.strftime("%Y-%m-%d %H:%M")).نسق(اللون="رمادي"، الحجم=١٣)
            زر("احذف"، لامدا م=م: احذف_ملاحظة(م)، النمط="ثانوي")
    الكل_ = ملاحظة.عد()
    الملخص.النص = f"{طول(ملاحظات)} من {الكل_} ملاحظة" إذا الكل_ وإلا "لا توجد ملاحظات بعد"


دالة احفظ_ملاحظة():
    إذا ليس حقل_العنوان.القيمة.شذب():
        تنبيه("اكتب عنوانا للملاحظة"، "تحذير")
        أرجع
    ملاحظة.أنشئ(العنوان=حقل_العنوان.القيمة.شذب()، المحتوى=حقل_المحتوى.القيمة.شذب()،
                 مهمة=خانة_المهمة.القيمة)
    حقل_العنوان.القيمة = ""
    حقل_المحتوى.القيمة = ""
    تنبيه("حُفظت الملاحظة"، "نجاح")
    اعرض()


دالة احذف_ملاحظة(م):
    م.أزل()
    اعرض()


إذا ملاحظة.عد() == ٠:
    ملاحظة.أنشئ(العنوان="مرحبا بك في مفكرتي"، المحتوى="ملاحظاتك تبقى محفوظة حتى بعد إغلاق الصفحة.")
    ملاحظة.أنشئ(العنوان="جرّب البحث"، المحتوى="اكتب كلمة في خانة البحث لتصفية الملاحظات."، مهمة=صح)
اعرض()
