# قائمة المهام: الإدخال والحاويات وإضافة العناصر وحذفها
من واجهات استورد *

عنوان_الصفحة("مهامي")
ترويسة("📝 مهامي"، المستوى=١)

المهام = []

مع أفقي():
    المدخل = حقل_نص(تلميح="مهمة جديدة…")
    زر("أضف"، لامدا: أضف_مهمة())

الملخص = تسمية("")
القائمة = عمودي()


دالة حدث_الملخص():
    المنجزة = مجموع(١ لكل م في المهام إذا م.القيمة)
    الملخص.النص = f"المنجز {المنجزة} من {طول(المهام)}"


دالة أضف_مهمة(النص=لاشيء):
    النص = (النص أو المدخل.القيمة).شذب()
    إذا ليس النص:
        تنبيه("اكتب المهمة أولا"، "تحذير")
        أرجع
    مهمة = مربع_اختيار(النص، عند_التغيير=لامدا: حدث_الملخص()، داخل=القائمة)
    المهام.أضف(مهمة)
    المدخل.القيمة = ""
    حدث_الملخص()


دالة احذف_المنجزة():
    لكل مهمة في [م لكل م في المهام إذا م.القيمة]:
        مهمة.أزل()
        المهام.أزل(مهمة)
    حدث_الملخص()
    تنبيه("حُذفت المهام المنجزة"، "نجاح")


المدخل.عند_الإرسال = لامدا ق: أضف_مهمة()
خط_فاصل()
زر("احذف المنجزة"، احذف_المنجزة، النمط="ثانوي")

لكل مهمة في ["تعلّم أساسيات أفعى"، "بناء أول تطبيق"، "نشر التطبيق"]:
    أضف_مهمة(مهمة)
