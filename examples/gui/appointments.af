# حجز المواعيد: التاريخ والوقت والألوان والاختيارات، مع قاعدة بيانات تحفظ المواعيد
من واجهات استورد *
من قواعد_البيانات استورد *
استورد datetime

عنوان_الصفحة("مواعيدي")
ق = قاعدة_بيانات("مواعيدي")


صنف موعد(نموذج):
    العنوان = عمود_نص(مطلوب=صح)
    التاريخ = عمود_تاريخ()
    الساعة = عمود_نص()
    النوع = عمود_نص()
    اللون = عمود_نص()


ق.أنشئ_جداول(موعد)
ترويسة("📅 مواعيدي"، المستوى=٢)
الجديد، القائمة = ألسنة(["➕ موعد جديد"، "🗂️ كل المواعيد"])

مع الجديد:
    مع بطاقة():
        العنوان_ = حقل_نص(تلميح="عنوان الموعد، مثلا: طبيب الأسنان")
        مع أفقي():
            اليوم_ = حقل_تاريخ(datetime.date.today()، الأدنى=datetime.date.today())
            الساعة_ = حقل_وقت("09:00")
            اللون_ = منتقي_لون("فيروزي")
        النوع_ = اختيار_واحد(["عمل"، "صحة"، "عائلة"، "دراسة"])
        تذكير = مفتاح_تبديل("ذكّرني قبلها بيوم"، مفعل=صح)
        زر("احجز الموعد"، لامدا: احجز())

مع القائمة:
    تسمية("اضغط على موعد لحذفه.").نسق(اللون="رمادي"، الحجم=١٤)
    الجدول = جدول([]، قابل_للبحث=صح، عند_الاختيار=لامدا م: اسأل_عن_الحذف(م))
    الرسم = رسم_بياني({}، النوع="حلقي"، العنوان="المواعيد حسب النوع"، الارتفاع=٢٢٠)


دالة حدث_القائمة():
    المواعيد = موعد.استعلام().رتب(موعد.التاريخ، موعد.الساعة).الكل()
    # الجدول يعرض المواعيد كما هي (كائنات النموذج)، والاختيار يعيد الموعد نفسه
    الجدول.الأعمدة = ["العنوان"، "التاريخ"، "الساعة"، "النوع"]
    الجدول.اعرض(المواعيد)
    الأنواع = {}
    لكل م في المواعيد:
        الأنواع[م.النوع] = الأنواع.احصل(م.النوع، ٠) + ١
    الرسم.اعرض(الأنواع)
    القائمة.العنوان = f"🗂️ كل المواعيد ({طول(المواعيد)})"


دالة احجز():
    إذا ليس العنوان_.القيمة.شذب() أو اليوم_.القيمة هو لاشيء:
        تنبيه("اكتب العنوان واختر اليوم"، "تحذير")
        أرجع
    موعد.أنشئ(العنوان=العنوان_.القيمة.شذب()، التاريخ=اليوم_.القيمة، الساعة=نص(الساعة_.القيمة)[:٥]،
               النوع=النوع_.القيمة، اللون=اللون_.القيمة)
    العنوان_.القيمة = ""
    حدث_القائمة()
    تنبيه("حُجز الموعد" + (" وسنذكّرك به" إذا تذكير.القيمة وإلا "")، "نجاح")


دالة اسأل_عن_الحذف(م):
    أكد(f"حذف موعد «{م.العنوان}»؟"، لامدا: احذف_موعدا(م))


دالة احذف_موعدا(م):
    م.أزل()
    حدث_القائمة()
    تنبيه("حُذف الموعد"، "تحذير")


حدث_القائمة()
