# سجل الطلاب: واجهة مع قاعدة بيانات تبقى بعد إغلاق الصفحة
من واجهات استورد *
من قواعد_البيانات استورد قاعدة_بيانات، خطأ_قاعدة_بيانات

ق = قاعدة_بيانات("سجل_الطلاب")
ق.نفذ("""
    أنشئ جدول إذا لم يوجد الطلاب (
        المعرف عدد_صحيح مفتاح أساسي زيادة تلقائية،
        الاسم نص غير فارغ فريد،
        العمر عدد_صحيح تحقق (العمر بين ٥ و ٣٠)،
        المدينة نص
    )
""")

عنوان_الصفحة("سجل الطلاب")
ترويسة("🎓 سجل الطلاب"، المستوى=١)
تسمية("البيانات محفوظة: أغلق الصفحة وافتحها وستجدها كما هي.")

مع بطاقة("طالب جديد"):
    مع شبكة(الأعمدة=٣):
        حقل_الاسم = حقل_نص(تلميح="الاسم")
        حقل_العمر = حقل_عدد(١٥، الأدنى=٥، الأقصى=٣٠)
        حقل_المدينة = قائمة_منسدلة(["الجزائر"، "وهران"، "قسنطينة"، "عنابة"، "سطيف"])
    زر("أضف الطالب"، لامدا: أضف())

مع أفقي():
    البحث = حقل_نص(تلميح="🔍 ابحث بالاسم…"، عند_التغيير=لامدا: اعرض())
    الترتيب = قائمة_منسدلة(["الاسم"، "العمر"، "المدينة"]، عند_التغيير=لامدا: اعرض())

الملخص = تسمية("")
الجدول = جدول(["المعرف"، "الاسم"، "العمر"، "المدينة"])

مع أفقي():
    حقل_الحذف = حقل_عدد(لاشيء، الأدنى=١)
    زر("احذف بالمعرف"، لامدا: احذف_طالبا()، النمط="خطر")


دالة اعرض():
    # اسم العمود يُدرج في الاستعلام من قائمة ثابتة، والقيم تُمرَّر بعلامة ؟
    صفوف = ق.استعلم(
        f"اختر * من الطلاب حيث الاسم يشبه ؟ رتب حسب {الترتيب.القيمة}"،
        f"%{البحث.القيمة}%")
    الجدول.اعرض(صفوف)
    إحصاء = ق.استعلم_واحدا("اختر عد(*) باسم العدد، قرب(متوسط(العمر)، ١) باسم المتوسط من الطلاب")
    الملخص.النص = f"عدد الطلاب: {إحصاء.العدد}" + (
        f" — متوسط العمر: {إحصاء.المتوسط}" إذا إحصاء.العدد وإلا "")


دالة أضف():
    الاسم = حقل_الاسم.القيمة.شذب()
    إذا ليس الاسم:
        تنبيه("اكتب اسم الطالب"، "تحذير")
        أرجع
    حاول:
        ق.نفذ("أدخل إلى الطلاب (الاسم، العمر، المدينة) القيم (؟، ؟، ؟)"،
              الاسم، حقل_العمر.القيمة، حقل_المدينة.القيمة)
    باستثناء خطأ_قاعدة_بيانات باسم خ:
        تنبيه(نص(خ).قسم("\n")[٠]، "خطأ")
        أرجع
    حقل_الاسم.القيمة = ""
    تنبيه(f"أُضيف {الاسم}"، "نجاح")
    اعرض()


دالة احذف_طالبا():
    إذا ق.نفذ("احذف من الطلاب حيث المعرف = ؟"، حقل_الحذف.القيمة):
        تنبيه("حُذف الطالب"، "نجاح")
        اعرض()
    وإلا:
        تنبيه("لا يوجد طالب بهذا المعرف"، "تحذير")


حقل_الاسم.عند_الإرسال = لامدا: أضف()

# بيانات أولية عند أول تشغيل فقط
إذا ق.قيمة("اختر عد(*) من الطلاب") == ٠:
    ق.نفذ_عدة("أدخل إلى الطلاب (الاسم، العمر، المدينة) القيم (؟، ؟، ؟)"، [
        ("أحمد"، ١٦، "الجزائر")، ("سارة"، ١٥، "وهران")، ("يوسف"، ١٧، "قسنطينة")])
اعرض()
