# لعبة الثعبان: لوحة المفاتيح، والمؤقت، والرسم على اللوحة
من واجهات استورد *
استورد عشوائي

عنوان_الصفحة("لعبة الثعبان")
الخانة = ٢٠
الأعمدة = ٢٠
الصفوف = ١٥
الاتجاهات = {"أعلى": (٠، -١)، "أسفل": (٠، ١)، "يمين": (١، ٠)، "يسار": (-١، ٠)}

مع أفقي():
    ترويسة("🐍 لعبة الثعبان"، المستوى=٢)
    النتيجة = تسمية("النقاط: ٠").نسق(عريض=صح)
    الأفضل = تسمية("الأفضل: ٠")
تسمية("استخدم الأسهم للتحريك، والمسافة للإيقاف المؤقت.").نسق(اللون="رمادي"، الحجم=١٤)
اللوحة = لوحة_رسم(الأعمدة * الخانة، الصفوف * الخانة، الخلفية="#1e293b")
مع أفقي():
    زر_البدء = زر("ابدأ من جديد"، لامدا: ابدأ())
    السرعة = قائمة_منسدلة(["بطيء"، "متوسط"، "سريع"]، القيمة="متوسط"، عند_التغيير=لامدا: ابدأ())

الحالة = {"أفضل": ٠}


دالة ضع_تفاحة():
    الفارغة = [(س، ص) لكل س في مدى(الأعمدة) لكل ص في مدى(الصفوف) إذا (س، ص) ليس في الحالة["الثعبان"]]
    الحالة["التفاحة"] = عشوائي.اختر(الفارغة)


دالة ارسم():
    اللوحة.امسح()
    س، ص = الحالة["التفاحة"]
    اللوحة.ارسم_نصا("🍎"، س * الخانة + الخانة / ٢، ص * الخانة + الخانة / ٢ + ١، الحجم=الخانة - ٢)
    لكل رقم، (س، ص) في مرقم(الحالة["الثعبان"]):
        لون = "#4ade80" إذا رقم == ٠ وإلا "#16a34a"
        اللوحة.ارسم_مستطيلا(س * الخانة + ١، ص * الخانة + ١، الخانة - ٢، الخانة - ٢،
                            اللون=لاشيء، التعبئة=لون، الزوايا=٥)
    إذا الحالة["انتهت"]:
        اللوحة.ارسم_مستطيلا(٠، ٠، الأعمدة * الخانة، الصفوف * الخانة، اللون=لاشيء، التعبئة="#00000099")
        اللوحة.ارسم_نصا("انتهت اللعبة"، الأعمدة * الخانة / ٢، الصفوف * الخانة / ٢ - ١٢،
                        اللون="أبيض"، الحجم=٢٨، عريض=صح)
        اللوحة.ارسم_نصا("اضغط إدخال للعب مجددا"، الأعمدة * الخانة / ٢، الصفوف * الخانة / ٢ + ٢٠،
                        اللون="#cbd5e1"، الحجم=١٥)
    وإلا إذا الحالة["متوقفة"]:
        اللوحة.ارسم_نصا("⏸ متوقفة"، الأعمدة * الخانة / ٢، الصفوف * الخانة / ٢، اللون="أبيض"، الحجم=٢٦)


دالة خطوة():
    إذا الحالة["انتهت"] أو الحالة["متوقفة"]:
        أرجع
    الحالة["الاتجاه"] = الحالة["التالي"]
    دس، دص = الاتجاهات[الحالة["الاتجاه"]]
    س، ص = الحالة["الثعبان"][٠]
    الرأس = ((س + دس) % الأعمدة، (ص + دص) % الصفوف)
    إذا الرأس في الحالة["الثعبان"][:-١]:
        الحالة["انتهت"] = صح
        الحالة["المؤقت"].أوقف()
        إذا الحالة["النقاط"] > الحالة["أفضل"]:
            الحالة["أفضل"] = الحالة["النقاط"]
            الأفضل.النص = f"الأفضل: {الحالة['أفضل']}"
            تنبيه("🏆 رقم قياسي جديد!"، "نجاح")
    وإلا:
        الحالة["الثعبان"].أدرج(٠، الرأس)
        إذا الرأس == الحالة["التفاحة"]:
            الحالة["النقاط"] += ١
            النتيجة.النص = f"النقاط: {الحالة['النقاط']}"
            ضع_تفاحة()
        وإلا:
            الحالة["الثعبان"].انزع()
    ارسم()


@عند_ضغط_مفتاح
دالة مفتاح(المفتاح):
    المعاكس = {"أعلى": "أسفل"، "أسفل": "أعلى"، "يمين": "يسار"، "يسار": "يمين"}
    إذا المفتاح في الاتجاهات و المفتاح != المعاكس[الحالة["الاتجاه"]]:
        الحالة["التالي"] = المفتاح
    وإلا إذا المفتاح == "مسافة" و ليس الحالة["انتهت"]:
        الحالة["متوقفة"] = ليس الحالة["متوقفة"]
        ارسم()
    وإلا إذا المفتاح == "إدخال" و الحالة["انتهت"]:
        ابدأ()


دالة ابدأ():
    إذا "المؤقت" في الحالة:
        الحالة["المؤقت"].أوقف()
    الحالة.حدث({
        "الثعبان": [(٥، ٧)، (٤، ٧)، (٣، ٧)]، "الاتجاه": "يمين"، "التالي": "يمين"،
        "النقاط": ٠، "انتهت": خطأ، "متوقفة": خطأ،
    })
    النتيجة.النص = "النقاط: ٠"
    ضع_تفاحة()
    ارسم()
    ثوان = {"بطيء": ٠.٢، "متوسط": ٠.١٢، "سريع": ٠.٠٧}[السرعة.القيمة]
    الحالة["المؤقت"] = كرر_كل(ثوان، خطوة)


ابدأ()
