# قواعد البيانات: SQL بالعربية مع SQLite
من قواعد_البيانات استورد قاعدة_بيانات، خطأ_قاعدة_بيانات

# على الجهاز تُحفظ في ملف «مكتبتي.db»، وفي المتصفح في ذاكرته الدائمة
ق = قاعدة_بيانات("مكتبتي")

ق.نفذ_الكل("""
    أنشئ جدول إذا لم يوجد الكتب (
        المعرف عدد_صحيح مفتاح أساسي،
        العنوان نص غير فارغ فريد،
        المؤلف نص،
        السنة عدد_صحيح،
        الصفحات عدد_صحيح
    )؛
    أنشئ جدول إذا لم يوجد الزيارات (الوقت نص افتراضي الوقت الحالي)؛
""")

# البيانات تبقى بين التشغيلات: شغّل البرنامج أكثر من مرة
ق.نفذ("أدخل إلى الزيارات القيم (الوقت الحالي)")
اطبع("هذه المرة رقم"، ق.قيمة("اختر عد(*) من الزيارات")، "التي تشغّل فيها البرنامج")

ق.نفذ_عدة("أدخل أو تجاهل إلى الكتب (العنوان، المؤلف، السنة، الصفحات) القيم (؟، ؟، ؟، ؟)"، [
    ("مقدمة ابن خلدون"، "ابن خلدون"، ١٣٧٧، ١٢٠٠)،
    ("كليلة ودمنة"، "ابن المقفع"، ٧٥٠، ٣٠٠)،
    ("رسالة الغفران"، "أبو العلاء المعري"، ١٠٣٣، ٢٥٠)،
    ("حي بن يقظان"، "ابن طفيل"، ١١٦٠، ١٥٠)،
])

اطبع("\nالكتب الأقدم من سنة ١١٠٠:")
لكل كتاب في ق.استعلم("اختر العنوان، المؤلف، السنة من الكتب حيث السنة أصغر من ؟ رتب حسب السنة"، ١١٠٠):
    اطبع(f"  • {كتاب['العنوان']} — {كتاب['المؤلف']} ({كتاب['السنة']})")

إحصاء = ق.استعلم_واحدا("اختر عد(*) باسم العدد، مجموع(الصفحات) باسم الصفحات، قرب(متوسط(الصفحات)) باسم المتوسط من الكتب")
اطبع(f"\nعدد الكتب: {إحصاء.العدد}، مجموع الصفحات: {إحصاء.الصفحات}، المتوسط: {إحصاء.المتوسط}")

# العنوان فريد: إدخاله مرتين يعطي خطأ عربيا واضحا
حاول:
    ق.نفذ("أدخل إلى الكتب (العنوان) القيم ('كليلة ودمنة')")
باستثناء خطأ_قاعدة_بيانات باسم خ:
    اطبع("\nخطأ متوقع:"، خ)
