# النماذج (ORM): الجداول أصناف، والاستعلامات دوال عربية
من قواعد_البيانات استورد *

ق = قاعدة_بيانات()   # في الذاكرة، أو قاعدة_بيانات("متجري") لتبقى البيانات


صنف منتج(نموذج):
    الاسم = عمود_نص(مطلوب=صح، فريد=صح)
    الصنف_ = عمود_نص(فهرس=صح)
    السعر = عمود_عدد_عشري(مطلوب=صح)
    الكمية = عمود_عدد_صحيح(افتراضي=٠)
    متوفر = عمود_منطقي(افتراضي=صح)


صنف طلب(نموذج):
    المنتج = عمود_مرجع(منتج)
    العدد = عمود_عدد_صحيح(افتراضي=١)
    التاريخ = عمود_تاريخ(تلقائي=صح)


ق.أنشئ_جداول(منتج، طلب)

# -- الإنشاء ----------------------------------------------------------------
منتج.أنشئ_عدة([
    {"الاسم": "تمر"، "الصنف_": "أغذية"، "السعر": ٨٠٠، "الكمية": ٥٠}،
    {"الاسم": "زيت زيتون"، "الصنف_": "أغذية"، "السعر": ١٢٠٠، "الكمية": ٢٠}،
    {"الاسم": "مصحف"، "الصنف_": "كتب"، "السعر": ١٥٠٠، "الكمية": ١٠}،
    {"الاسم": "دفتر"، "الصنف_": "أدوات"، "السعر": ١٥٠، "الكمية": ٠، "متوفر": خطأ}،
])
قلم = منتج.أنشئ(الاسم="قلم"، الصنف_="أدوات"، السعر=٥٠، الكمية=١٠٠)
اطبع("أُنشئ:"، قلم)

# -- الاستعلام ---------------------------------------------------------------
اطبع("\nالمنتجات المتوفرة من الأغلى:")
لكل م في منتج.حيث(متوفر=صح).رتب(-منتج.السعر):
    اطبع(f"  {م.الاسم}: {م.السعر:g} دج ({م.الكمية} قطعة)")

رخيصة = منتج.حيث((منتج.السعر < ١٠٠٠) & (منتج.الكمية > ٠))
اطبع("\nرخيصة ومتوفرة:"، [م.الاسم لكل م في رخيصة]، "العدد:"، رخيصة.عد())
اطبع("من الأغذية أو الكتب:"، [م.الاسم لكل م في منتج.حيث(منتج.الصنف_.ضمن(["أغذية"، "كتب"]))])
اطبع("اسمه يبدأ بـ «ز»:"، منتج.احصل(منتج.الاسم.يبدأ_ب("ز")))
اطبع("متوسط الأسعار:"، منتج.استعلام().متوسط(منتج.السعر))

# -- التعديل ------------------------------------------------------------------
دفتر = منتج.احصل(الاسم="دفتر")
دفتر.الكمية = ٣٠
دفتر.متوفر = صح
دفتر.احفظ()
اطبع("\nعُدّل:"، منتج.احصل(الاسم="دفتر"))

تخفيض = منتج.حيث(الصنف_="أدوات").حدث(السعر=٤٠)
اطبع("خُفّض سعر"، تخفيض، "منتجات")

# -- العلاقات -----------------------------------------------------------------
طلب.أنشئ(المنتج=قلم، العدد=٣)
طلب.أنشئ(المنتج=منتج.احصل(الاسم="تمر")، العدد=٢)
لكل ط في طلب.الكل():
    اطبع(f"طلب رقم {ط.المعرف}: {ط.العدد} × {ط.المنتج.الاسم} = {ط.العدد * ط.المنتج.السعر:g} دج")

# -- الحذف --------------------------------------------------------------------
قلم.أزل()   # تُحذف طلباته معه (عند_الحذف="تتالي")
اطبع("\nبعد حذف القلم: المنتجات"، منتج.عد()، "والطلبات"، طلب.عد())

# -- الأخطاء بالعربية ------------------------------------------------------------
حاول:
    منتج.أنشئ(الاسم="تمر"، السعر=١)
باستثناء خطأ_قاعدة_بيانات باسم خ:
    اطبع("خطأ متوقع:"، خ)
