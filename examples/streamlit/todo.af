# قائمة المهام: استمارة وأزرار مع حفظ دائم في قاعدة بيانات (نموذج ORM)
استورد ستريمليت باسم ست
من قواعد_البيانات استورد *

ست.اضبط_الصفحة(عنوان_الصفحة="مهامي"، أيقونة_الصفحة="📝")

# تُحفظ المهام في ملف (أو في ذاكرة المتصفح الدائمة) فتبقى بعد إعادة فتح الموقع
ق = قاعدة_بيانات("مهامي")


صنف مهمة(نموذج):
    النص = عمود_نص(مطلوب=صح)
    منجزة = عمود_منطقي(افتراضي=خطأ)


ق.أنشئ_جداول(مهمة)
ست.عنوان("📝 مهامي")

مع ست.استمارة("جديدة"، امسح_عند_الإرسال=صح):
    أ، ب = ست.أعمدة([٤، ١]، المحاذاة_العمودية="أسفل")
    النص = أ.حقل_نص("مهمة جديدة"، تلميح="مثلا: مراجعة الدرس")
    إذا ب.زر_إرسال("أضف"، نوع="أساسي") و النص.شذب():
        مهمة.أنشئ(النص=النص.شذب())

المهام = مهمة.الكل()
العدد = مجموع(١ لكل م في المهام إذا م.منجزة)
إذا المهام:
    ست.شريط_تقدم(العدد / طول(المهام)، النص=f"المنجز {العدد} من {طول(المهام)}")
وإلا:
    ست.معلومة("لا توجد مهام بعد. أضف أول مهمة!")

لكل م في المهام:
    أ، ب = ست.أعمدة([٦، ١]، المحاذاة_العمودية="وسط")
    منجزة = أ.مربع_اختيار(م.النص، القيمة=م.منجزة، مفتاح=f"مهمة-{م.المعرف}")
    إذا منجزة != م.منجزة:
        م.منجزة = منجزة
        م.احفظ()
        ست.أعد_التشغيل()
    إذا ب.زر("🗑️"، مفتاح=f"احذف-{م.المعرف}"، مساعدة="احذف المهمة"):
        م.أزل()
        ست.أعد_التشغيل()

إذا العدد:
    إذا ست.زر("احذف المهام المنجزة"):
        مهمة.حيث(منجزة=صح).أزل()
        ست.أعد_التشغيل()
