# لوحة المبيعات: مقاييس ورسوم بيانية وجدول مع مرشحات في الشريط الجانبي
استورد ستريمليت باسم ست
استورد عشوائي

ست.اضبط_الصفحة(عنوان_الصفحة="لوحة المبيعات"، أيقونة_الصفحة="📊"، التخطيط="واسع")

الأشهر = ["يناير"، "فبراير"، "مارس"، "أبريل"، "مايو"، "يونيو"،
          "يوليو"، "أغسطس"، "سبتمبر"، "أكتوبر"، "نوفمبر"، "ديسمبر"]
الفروع = ["الجزائر"، "وهران"، "قسنطينة"، "عنابة"]


@ست.خزن_البيانات
دالة بيانات_المبيعات():
    عشوائي.بذرة(٧)
    أرجع {فرع: [عشوائي.عدد_عشوائي(٥٠، ١٥٠) لكل _ في الأشهر] لكل فرع في الفروع}


المبيعات = بيانات_المبيعات()

مع ست.الشريط_الجانبي:
    ست.ترويسة("المرشحات")
    المختارة = ست.اختيار_متعدد("الفروع"، الفروع، افتراضي=الفروع)
    من_، إلى = ست.منزلق_خيارات("الفترة"، الخيارات=الأشهر، القيمة=(الأشهر[٠]، الأشهر[-١]))

ست.عنوان("📊 لوحة المبيعات")
إذا ليس المختارة:
    ست.تحذير("اختر فرعا واحدا على الأقل من الشريط الجانبي.")
    ست.أوقف()

البداية، النهاية = الأشهر.فهرس(من_)، الأشهر.فهرس(إلى) + ١
الفترة = الأشهر[البداية:النهاية]
البيانات = {فرع: المبيعات[فرع][البداية:النهاية] لكل فرع في المختارة}
المجموع = مجموع(مجموع(ق) لكل ق في البيانات.القيم())
الأفضل = أكبر(البيانات، مفتاح=لامدا ف: مجموع(البيانات[ف]))

أ، ب، ج = ست.أعمدة(٣)
أ.مقياس("إجمالي المبيعات"، f"{المجموع:,} ألف د.ج")
ب.مقياس("متوسط الشهر"، f"{المجموع // طول(الفترة):,}")
ج.مقياس("أفضل فرع"، الأفضل)

الخطي، الأعمدة، الجدول = ست.ألسنة(["📈 تطور المبيعات"، "📊 مقارنة الفروع"، "🗂️ الجدول"])
مع الخطي:
    ست.رسم_خطي(البيانات)
مع الأعمدة:
    ست.رسم_أعمدة({"المبيعات": [مجموع(البيانات[ف]) لكل ف في المختارة]}، الارتفاع=٣٥٠)
مع الجدول:
    ست.جدول_بيانات({"الشهر": الفترة، **البيانات}، إخفاء_الفهرس=صح)
