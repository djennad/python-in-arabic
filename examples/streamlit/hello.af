# مرحبا ستريمليت: أول موقع تفاعلي بسطور قليلة
استورد ستريمليت باسم ست

ست.اضبط_الصفحة(عنوان_الصفحة="مرحبا"، أيقونة_الصفحة="👋")
ست.عنوان("👋 أول موقع بلغة أفعى")
ست.تعليق("كل تغيير في الحقول يعيد تشغيل البرنامج ويحدّث الصفحة فورا.")

الاسم = ست.حقل_نص("ما اسمك؟"، تلميح="اكتب اسمك هنا")
العمر = ست.منزلق("كم عمرك؟"، الأدنى=٥، الأقصى=٩٩، القيمة=٢٠)
اللون = ست.منتقي_لون("لونك المفضل"، القيمة="#0f766e")

إذا الاسم:
    ست.نجاح(f"أهلا يا {الاسم}! عمرك {العمر} سنة.")
    ست.نص_منسق(f"لونك المفضل: <span style='color:{اللون}'>■■■</span> `{اللون}`"، unsafe_allow_html=صح)
    إذا ست.زر("احتفل 🎉"، نوع="أساسي"):
        ست.بالونات()
وإلا:
    ست.معلومة("اكتب اسمك لتبدأ.")
