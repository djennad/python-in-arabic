# محادثة: واجهة دردشة تحفظ الرسائل في حالة الجلسة
استورد ستريمليت باسم ست

ست.اضبط_الصفحة(عنوان_الصفحة="محادثة"، أيقونة_الصفحة="💬")
ست.عنوان("💬 روبوت المحادثة")
ست.تعليق("روبوت بسيط يرد على التحية والأسئلة عن الوقت والحساب.")

الحالة = ست.حالة_الجلسة
إذا "رسائل" ليس في الحالة:
    الحالة["رسائل"] = [("مساعد"، "مرحبا! اسألني عن الوقت، أو اكتب عملية حسابية مثل ٣ * ٧")]


دالة رد(النص):
    استورد تاريخ_وقت
    إذا "مرحبا" في النص أو "السلام" في النص:
        أرجع "أهلا وسهلا! كيف أساعدك؟"
    إذا "الوقت" في النص أو "الساعة" في النص:
        أرجع f"الساعة الآن {تاريخ_وقت.تاريخ_وقت.الآن():%H:%M}"
    الأرقام = النص.translate(نص.maketrans("٠١٢٣٤٥٦٧٨٩×÷"، "0123456789*/"))
    إذا الكل(ح في "0123456789+-*/(). " لكل ح في الأرقام) و أي(ح.رقمي() لكل ح في الأرقام):
        حاول:
            أرجع f"النتيجة: {قيم(الأرقام)}"
        باستثناء استثناء:
            أرجع "لم أستطع حساب هذه العملية."
    أرجع f"قلتَ: «{النص}». جرّب أن تسألني عن الوقت."


لكل الدور، النص في الحالة["رسائل"]:
    مع ست.رسالة_دردشة(الدور):
        ست.اكتب(النص)

السؤال = ست.حقل_دردشة("اكتب رسالتك…")
إذا السؤال:
    الحالة["رسائل"].أضف(("مستخدم"، السؤال))
    الحالة["رسائل"].أضف(("مساعد"، رد(السؤال)))
    ست.أعد_التشغيل()
